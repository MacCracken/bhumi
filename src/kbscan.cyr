# @public — bhumi input drain: the kernel handoff (agnos kbscan#42).
#
# The events-in counterpart to scanout.cyr. Pulls USB HID keyboard reports from
# the kernel and feeds them through the report-diff decoder in input.cyr. The
# single sys_kbscan wrapper is the only target-specific code; everything else is
# pure and host-tested.
#
# kbscan#42 (agnos, keyboard-only): sys_kbscan(buf, max) copies up to `max` bytes
# of pending USB HID keyboard report data — 8-byte boot keyboard reports — from
# the kernel's ring into `buf`, non-blocking; returns the byte count (0 = none).
# bhumi drains whole reports and diffs each against the previous one to derive
# press/release (HID reports are state, not events). `max` is a multiple of the
# 8-byte report size so whole reports land per poll; anything still queued drains
# on the next poll.
#
# Flat domain module: no stdlib includes (see src/main.cyr). Depends on
# input.cyr (bhumi_kbd_diff + the BHUMI_HID_* layout), which precedes it in the
# include chain and the [lib].modules bundle order.

# Bytes drained per poll — a multiple of BHUMI_HID_REPORT_SIZE (8) so whole
# reports always land. The stack buffer in bhumi_input_poll mirrors this size.
var BHUMI_INPUT_DRAIN_MAX = 64;   # up to 8 buffered reports per poll

# ================================================================
# Kernel seam — the ONLY target-specific code. Exactly one branch compiles.
# ================================================================

#ifdef CYRIUS_TARGET_AGNOS
fn _bhumi_kbscan(buf, max): i64 { return sys_kbscan(buf, max); }
#endif

#ifndef CYRIUS_TARGET_AGNOS
# Non-agnos: `kbscan` is an agnos syscall and has no counterpart anywhere else. The Linux keyboard
# does NOT come through here — evdev is a stream of 24-byte records, not a scancode buffer, so it gets
# its own poll arm below rather than being forced through a drain-then-decode shape it does not fit.
fn _bhumi_kbscan(buf, max): i64 { return 0; }
#endif

#ifdef CYRIUS_TARGET_LINUX
# --- Linux evdev keyboard (M6-B4) ------------------------------------------------------------------
#
# ⭐ THE CODE MAPPING IS FREE, WHICH IS WHY THIS IS SMALL. Linux `KEY_*` base codes ARE AT/XT Set-1
# make codes — `KEY_ESC` is 1, `KEY_Q` is 0x10 — so `_bhumi_set1_to_hid` below already translates them
# to HID usages with no second table and no new vocabulary.
# ⛔ THE EXTENDED PLANE IS **NOT** COVERED and must not be assumed: `_bhumi_set1_ext_to_hid` is keyed
# on **0xE0-prefixed** Set-1 codes, and **evdev never emits a 0xE0 prefix** — it gives flat codes
# (KEY_UP is 103, not E0 48). Arrows, RCtrl/RAlt/Meta, Home/End/PgUp/PgDn and Insert/Delete therefore
# fall out here as unmapped and are dropped. A second table keyed on evdev's own numbers is the fix.
#
# ⚠ NO CAPABILITY PROBE. The obvious design opens each node and asks `EVIOCGBIT` whether it is a
# keyboard; that needs an ioctl and a bitmask struct. Opening every node and keeping only `EV_KEY`
# records gets the same result with no ioctl — a mouse simply contributes nothing until we want its
# buttons, at which point they arrive on the same records for free.
# ⚠ Reading evdev does not consume from other readers: each open gets its own copy, so this cannot
# steal keystrokes from a shell sharing the console.

var BHUMI_LX_EVDEV_MAX  = 8;              # nodes held open at once
var BHUMI_LX_EVDEV_SCAN = 24;             # /dev/input/event0 .. event23
var BHUMI_LX_EV_SIZE    = 24;             # struct input_event on x86_64: timeval(16) + type,code(4) + value(4)
var BHUMI_LX_EV_TYPE    = 16;             # u16
var BHUMI_LX_EV_CODE    = 18;             # u16
var BHUMI_LX_EV_VALUE   = 20;             # s32: 0 release, 1 press, 2 autorepeat
var BHUMI_LX_EV_KEY     = 1;              # EV_KEY
var BHUMI_LX_EV_REL     = 2;              # EV_REL — relative motion
var BHUMI_LX_REL_X      = 0;
var BHUMI_LX_REL_Y      = 1;
var BHUMI_LX_O_RD_NB    = 2048;           # O_RDONLY | O_NONBLOCK (0 | 04000)
var BHUMI_LX_RESCAN     = 60;             # polls between rescans while NO node is open

var _bhumi_lx_kfd[8];                     # 8 u64 slots — open evdev descriptors
var _bhumi_lx_kn    = 0;
var _bhumi_lx_kinit = 0;
var _bhumi_lx_retry = 0;                  # polls since the last rescan
var _bhumi_lx_seenmask = 0;               # bit N = /dev/input/eventN is already open

# ⛔⛔ ONE DRAIN FEEDS BOTH STREAMS, AND ON LINUX IT HAS TO. On agnos the keyboard (`kbscan #42`) and
# the pointer (`ptrscan #98`) are separate syscalls over separate kernel rings, so two independent
# drains are correct there. On Linux **they share one fd and a read CONSUMES**: whichever of
# `bhumi_input_poll` / `bhumi_pointer_poll` ran first would swallow the other's records and the second
# would find an empty device. So the read happens once, here, and each caller collects its own share.
# ⚠ That is also why the keyboard events are QUEUED rather than returned directly: a drain triggered by
# `bhumi_pointer_poll` may surface keys nobody asked for yet, and dropping them would lose keystrokes
# depending on which poll the consumer happened to call first.
var _bhumi_lx_kq[128];                    # pending key events, FIFO
var _bhumi_lx_kq_n  = 0;
# Pointer accumulator — the fold agnos's kernel does for us in `hid_process_mouse_report`. Motion is a
# RELATIVE DELTA, so the useful unit is the sum since the last read.
var _bhumi_lx_dx    = 0;
var _bhumi_lx_dy    = 0;
var _bhumi_lx_btn   = 0;                  # current level
var _bhumi_lx_seen  = 0;                  # OR since the last pointer read

# Build "/dev/input/eventN" into `out`. -> length.
fn _bhumi_lx_evpath(n, out): i64 {
    var p = "/dev/input/event";
    var i = 0;
    while (i < 16) { store8(out + i, load8(p + i)); i = i + 1; }
    if (n >= 10) { store8(out + i, 48 + (n / 10)); i = i + 1; }
    store8(out + i, 48 + (n % 10)); i = i + 1;
    store8(out + i, 0);
    return i;
}

# Open every readable evdev node, and KEEP LOOKING for ones that appear later.
#
# ⛔⛔ TWO LATCHING BUGS IN A ROW HERE, AND THE SECOND WAS SUBTLER THAN THE FIRST.
# (1) The first cut scanned ONCE and set a done-flag. The first poll happens milliseconds after boot,
#     before USB enumeration finishes, so with `-device usb-kbd` it found nothing and never looked
#     again — every keystroke lost, compositor reporting nothing wrong.
# (2) The fix retried only WHILE ZERO nodes were open. That still fails the ordinary USB case: the
#     mouse enumerated first, the count went above zero, the scan latched, and **the keyboard node was
#     never opened**. Measured exactly that — `pointer motion received` with the Esc never arriving.
# ⇒ Rescan on a fixed cadence regardless of how many nodes are open, and remember per-INDEX which are
# already held so a rescan only opens what is new. Handles late enumeration and hotplug with the same
# mechanism, and costs 24 `open` attempts once every `BHUMI_LX_RESCAN` polls.
# ⚠ A node that DISAPPEARS is not reaped; its fd just goes quiet. Unplugging is not handled.
fn _bhumi_lx_kbd_open(): i64 {
    if (_bhumi_lx_kinit == 1) {
        _bhumi_lx_retry = _bhumi_lx_retry + 1;
        if (_bhumi_lx_retry < BHUMI_LX_RESCAN) { return _bhumi_lx_kn; }
    }
    _bhumi_lx_retry = 0;
    _bhumi_lx_kinit = 1;
    var path[32];
    var n = 0;
    while (n < BHUMI_LX_EVDEV_SCAN) {
        if (_bhumi_lx_kn >= BHUMI_LX_EVDEV_MAX) { return _bhumi_lx_kn; }
        var bit = 1 << n;
        if ((_bhumi_lx_seenmask & bit) == 0) {
            _bhumi_lx_evpath(n, &path);
            var fd = sys_open(&path, BHUMI_LX_O_RD_NB, 0);
            # ⚠ A failed open is the NORMAL case for most nodes, and for every node on a box whose user
            # is not in the `input` group. Silent by design: a compositor logging 24 permission
            # failures per rescan trains its operator to ignore the log.
            if (fd >= 0) {
                store64(&_bhumi_lx_kfd + _bhumi_lx_kn * 8, fd);
                _bhumi_lx_kn = _bhumi_lx_kn + 1;
                _bhumi_lx_seenmask = _bhumi_lx_seenmask | bit;
            }
        }
        n = n + 1;
    }
    return _bhumi_lx_kn;
}

# Map an evdev EXTENDED key code to a HID usage. -> usage, or 0 if not an extended key.
#
# ⛔⛔ WHY A SECOND TABLE EXISTS AT ALL, when `_bhumi_set1_to_hid` handles the base plane for free.
# Linux `KEY_*` base codes ARE AT/XT Set-1 make codes, which is why the base plane needed no work. The
# extended plane is where that stops: Set-1 encodes those keys as a **0xE0 PREFIX followed by a byte**
# (Up is `E0 48`), and `_bhumi_set1_ext_to_hid` is keyed on that second byte — but **evdev never emits
# a 0xE0 prefix**. It gives one flat number (`KEY_UP` is 103). So the existing ext table can never
# match on this arm, and every one of these keys silently fell out as unmapped.
# ⚠ There is NO overlap hazard with the base table: it tops out at 0x58 (F12) and answers 0 for
# everything from 96 up, so these codes were dropped rather than mis-mapped. Checked before relying on it.
# ⚠ This is keyed on **evdev's own numbering**, not Set-1, so it is Linux-only by construction and
# lives inside the Linux arm rather than beside the Set-1 tables agnos shares.
fn _bhumi_evdev_ext_to_hid(code): i64 {
    if (code == 96)  { return 0x58; }   # KP Enter
    if (code == 97)  { return 0xE4; }   # RCtrl
    if (code == 98)  { return 0x54; }   # KP /
    if (code == 99)  { return 0x46; }   # PrintScreen (SysRq)
    if (code == 100) { return 0xE6; }   # RAlt
    if (code == 102) { return 0x4A; }   # Home
    if (code == 103) { return 0x52; }   # Up
    if (code == 104) { return 0x4B; }   # PageUp
    if (code == 105) { return 0x50; }   # Left
    if (code == 106) { return 0x4F; }   # Right
    if (code == 107) { return 0x4D; }   # End
    if (code == 108) { return 0x51; }   # Down
    if (code == 109) { return 0x4E; }   # PageDown
    if (code == 110) { return 0x49; }   # Insert
    if (code == 111) { return 0x4C; }   # Delete
    if (code == 119) { return 0x48; }   # Pause
    if (code == 125) { return 0xE3; }   # LMeta / LGUI
    if (code == 126) { return 0xE7; }   # RMeta / RGUI
    if (code == 127) { return 0x65; }   # Menu / Application
    return 0;
}

# Map an evdev BTN_* code to bhumi's button bitmask. -> mask, or 0 if not a pointer button.
# ⚠ Bit 0 is LEFT because that is what the consumer already assumes — aethersafha drives its drag
# state machine from `input_btn_transitions(..., 1)`, "left button only, for now".
fn _bhumi_lx_btn_mask(code): i64 {
    if (code == 272) { return 1; }        # BTN_LEFT
    if (code == 273) { return 2; }        # BTN_RIGHT
    if (code == 274) { return 4; }        # BTN_MIDDLE
    return 0;
}

# Read every open node once, queueing key events and folding pointer motion/buttons. -> 0.
fn _bhumi_lx_drain(): i64 {
    if (_bhumi_lx_kbd_open() == 0) { return 0; }
    var buf[1536];                        # 64 records x 24 B
    var d = 0;
    while (d < _bhumi_lx_kn) {
        var got = sys_read(load64(&_bhumi_lx_kfd + d * 8), &buf, 1536);
        # EAGAIN on an idle node is the common answer; anything non-positive means "nothing here".
        if (got > 0) {
            var off = 0;
            # ⚠ A trailing PARTIAL record is left unprocessed rather than half-decoded — the same rule
            # `bhumi_input_process` applies to an 8-byte HID report that arrived split.
            while ((off + BHUMI_LX_EV_SIZE) <= got) {
                var ty  = load16(&buf + off + BHUMI_LX_EV_TYPE);
                var cd  = load16(&buf + off + BHUMI_LX_EV_CODE);
                var val = bhumi__s32_of(load32(&buf + off + BHUMI_LX_EV_VALUE));
                if (ty == BHUMI_LX_EV_KEY) {
                    var bm = _bhumi_lx_btn_mask(cd);
                    if (bm != 0) {
                        # A pointer button. ⚠ `seen` is OR-only and is what catches a click that begins
                        # AND ends inside one frame; without it a fast click is invisible.
                        if (val > 0) { _bhumi_lx_btn = _bhumi_lx_btn | bm; _bhumi_lx_seen = _bhumi_lx_seen | bm; }
                        else { _bhumi_lx_btn = _bhumi_lx_btn & (0xFF - bm); }
                    }
                    else {
                        # ⛔ value 2 is AUTOREPEAT and is DROPPED. bhumi's model is a press/release
                        # edge; forwarding a repeat as another press delivers a key the user never
                        # pressed again, and a consumer diffing press/release state would see an
                        # impossible double-down. Repeat is policy, not drain.
                        if (val < 2) {
                            var usage = _bhumi_set1_to_hid(cd);
                            # Base plane first (it is the common case), then the evdev-keyed extended
                            # table. Order matters only for cost, not correctness — the two ranges are
                            # disjoint, which is why the base table can answer 0 as a clean "not mine".
                            if (usage == 0) { usage = _bhumi_evdev_ext_to_hid(cd); }
                            if (usage != 0) {
                                if (_bhumi_lx_kq_n < 128) {
                                    store64(&_bhumi_lx_kq + _bhumi_lx_kq_n * 8, bhumi_key_event(val, usage));
                                    _bhumi_lx_kq_n = _bhumi_lx_kq_n + 1;
                                }
                            }
                        }
                    }
                }
                if (ty == BHUMI_LX_EV_REL) {
                    if (cd == BHUMI_LX_REL_X) { _bhumi_lx_dx = _bhumi_lx_dx + val; }
                    if (cd == BHUMI_LX_REL_Y) { _bhumi_lx_dy = _bhumi_lx_dy + val; }
                }
                off = off + BHUMI_LX_EV_SIZE;
            }
        }
        d = d + 1;
    }
    return 0;
}

# Pop up to `max_ev` queued key events. -> count written.
fn _bhumi_lx_kbd_poll(out, max_ev): i64 {
    _bhumi_lx_drain();
    var w = 0;
    while (w < max_ev) {
        if (w >= _bhumi_lx_kq_n) { break; }
        store64(out + w * 8, load64(&_bhumi_lx_kq + w * 8));
        w = w + 1;
    }
    # Shift the remainder down rather than dropping it — a consumer with a small budget must not lose
    # keys, only receive them a frame later.
    var r = w;
    var k = 0;
    while (r < _bhumi_lx_kq_n) {
        store64(&_bhumi_lx_kq + k * 8, load64(&_bhumi_lx_kq + r * 8));
        k = k + 1;
        r = r + 1;
    }
    _bhumi_lx_kq_n = _bhumi_lx_kq_n - w;
    return w;
}

# Fill a 16-byte ptrscan-shaped record from the accumulator and reset the deltas. -> 16.
# ⭐ Synthesising the RECORD rather than the events is what makes this small: `bhumi_ptr_decode` is
# pure, already unit-tested, and shared with agnos, so the Linux arm owns only the fold.
# ⚠ `btn` is a LEVEL and must NOT be cleared here; `dx`/`dy`/`seen` are per-read and must be.
fn _bhumi_lx_ptr_take(rec): i64 {
    _bhumi_lx_drain();
    store32(rec + 0, _bhumi_lx_dx & 0xFFFFFFFF);
    store32(rec + 4, _bhumi_lx_dy & 0xFFFFFFFF);
    store32(rec + 8, _bhumi_lx_btn & 0xFF);
    store32(rec + 12, _bhumi_lx_seen & 0xFF);
    _bhumi_lx_dx = 0;
    _bhumi_lx_dy = 0;
    _bhumi_lx_seen = _bhumi_lx_btn & 0xFF;   # a still-held button stays "seen" next read
    return BHUMI_PTR_RECORD;
}
#endif

# ================================================================
# Drain + decode
# ================================================================

# Initialize a caller-held previous-report buffer (BHUMI_HID_REPORT_SIZE bytes)
# to "all keys up". Call once before the first poll.
fn bhumi_input_init(prev): i64 {
    var i = 0;
    while (i < BHUMI_HID_REPORT_SIZE) { store8(prev + i, 0); i = i + 1; }
    return 0;
}

# Process `n` drained bytes at `raw` as a sequence of whole 8-byte HID reports,
# diffing each against `prev` (updated in place to the last report seen) into key
# events at `out` (up to `max_ev`). Returns the event count. Pure — the
# host-testable core of bhumi_input_poll. A trailing partial report (n not a
# multiple of 8) is left unprocessed.
fn bhumi_input_process(prev, raw, n, out, max_ev): i64 {
    var w = 0;
    var off = 0;
    while ((off + BHUMI_HID_REPORT_SIZE) <= n) {
        if (w >= max_ev) { return w; }
        w = w + bhumi_kbd_diff(prev, raw + off, out + (w * 8), max_ev - w);
        var j = 0;
        while (j < BHUMI_HID_REPORT_SIZE) {
            store8(prev + j, load8(raw + off + j));
            j = j + 1;
        }
        off = off + BHUMI_HID_REPORT_SIZE;
    }
    return w;
}

# ================================================================
# Set-1 scancode decode — the agnos keyboard path
# ================================================================
# agnos kbscan#42 delivers raw AT/XT **Set-1** scancodes (make + break, plus
# 0xE0-extended), NOT USB HID reports — it is the same raw-scancode pipe doom's
# input_poll drains (agnos kernel/core/syscall.cyr, num==42). So on agnos bhumi
# decodes Set-1 directly into the SAME normalized key events (HID usage +
# press/release) the compositor already consumes, instead of diffing HID reports.
# Set-1 is self-describing (make vs break = bit 7), so no prev-state is needed.
# Pure + host-testable: bhumi_scancode_process runs on any target.
#
# Tables derived from the AT/XT Set-1 layout + the USB HID Usage Table
# (Keyboard/Keypad page 0x07) — multi-source, not Linux-specific.

# Base-plane Set-1 make code (0x01-0x58) -> USB HID usage. 0 = unmapped.
fn _bhumi_set1_to_hid(code): i64 {
    if (code == 0x01) { return 0x29; }                             # Esc
    if ((code >= 0x02) && (code <= 0x0A)) { return code + 0x1C; }  # 1..9 -> HID 0x1E..0x26
    if (code == 0x0B) { return 0x27; }                             # 0
    if (code == 0x0C) { return 0x2D; }                             # -
    if (code == 0x0D) { return 0x2E; }                             # =
    if (code == 0x0E) { return 0x2A; }                             # Backspace
    if (code == 0x0F) { return 0x2B; }                             # Tab
    if (code == 0x10) { return 0x14; }  # q
    if (code == 0x11) { return 0x1A; }  # w
    if (code == 0x12) { return 0x08; }  # e
    if (code == 0x13) { return 0x15; }  # r
    if (code == 0x14) { return 0x17; }  # t
    if (code == 0x15) { return 0x1C; }  # y
    if (code == 0x16) { return 0x18; }  # u
    if (code == 0x17) { return 0x0C; }  # i
    if (code == 0x18) { return 0x12; }  # o
    if (code == 0x19) { return 0x13; }  # p
    if (code == 0x1A) { return 0x2F; }  # [
    if (code == 0x1B) { return 0x30; }  # ]
    if (code == 0x1C) { return 0x28; }  # Enter
    if (code == 0x1D) { return 0xE0; }  # LCtrl
    if (code == 0x1E) { return 0x04; }  # a
    if (code == 0x1F) { return 0x16; }  # s
    if (code == 0x20) { return 0x07; }  # d
    if (code == 0x21) { return 0x09; }  # f
    if (code == 0x22) { return 0x0A; }  # g
    if (code == 0x23) { return 0x0B; }  # h
    if (code == 0x24) { return 0x0D; }  # j
    if (code == 0x25) { return 0x0E; }  # k
    if (code == 0x26) { return 0x0F; }  # l
    if (code == 0x27) { return 0x33; }  # ;
    if (code == 0x28) { return 0x34; }  # '
    if (code == 0x29) { return 0x35; }  # `
    if (code == 0x2A) { return 0xE1; }  # LShift
    if (code == 0x2B) { return 0x31; }  # backslash
    if (code == 0x2C) { return 0x1D; }  # z
    if (code == 0x2D) { return 0x1B; }  # x
    if (code == 0x2E) { return 0x06; }  # c
    if (code == 0x2F) { return 0x19; }  # v
    if (code == 0x30) { return 0x05; }  # b
    if (code == 0x31) { return 0x11; }  # n
    if (code == 0x32) { return 0x10; }  # m
    if (code == 0x33) { return 0x36; }  # ,
    if (code == 0x34) { return 0x37; }  # .
    if (code == 0x35) { return 0x38; }  # /
    if (code == 0x36) { return 0xE5; }  # RShift
    if (code == 0x37) { return 0x55; }  # KP *
    if (code == 0x38) { return 0xE2; }  # LAlt
    if (code == 0x39) { return 0x2C; }  # Space
    if (code == 0x3A) { return 0x39; }  # CapsLock
    if ((code >= 0x3B) && (code <= 0x44)) { return code - 1; }     # F1..F10 -> HID 0x3A..0x43
    if (code == 0x57) { return 0x44; }                             # F11
    if (code == 0x58) { return 0x45; }                             # F12
    return 0;
}

# 0xE0-prefixed extended Set-1 code -> USB HID usage. 0 = unmapped.
fn _bhumi_set1_ext_to_hid(code): i64 {
    if (code == 0x1D) { return 0xE4; }  # RCtrl
    if (code == 0x38) { return 0xE6; }  # RAlt
    if (code == 0x47) { return 0x4A; }  # Home
    if (code == 0x48) { return 0x52; }  # Up
    if (code == 0x49) { return 0x4B; }  # PageUp
    if (code == 0x4B) { return 0x50; }  # Left
    if (code == 0x4D) { return 0x4F; }  # Right
    if (code == 0x4F) { return 0x4D; }  # End
    if (code == 0x50) { return 0x51; }  # Down
    if (code == 0x51) { return 0x4E; }  # PageDown
    if (code == 0x52) { return 0x49; }  # Insert
    if (code == 0x53) { return 0x4C; }  # Delete
    return 0;
}

# Decode `n` raw Set-1 scancode bytes at `raw` into normalized key events at
# `out` (up to `max_ev`); returns the event count. Handles 0xE0-extended keys
# (prefix + code land in the same drain, which is how a keystroke enqueues) and
# skips the 0xE1 (Pause) lead. Pure — the host-testable agnos-input core, the
# Set-1 counterpart to bhumi_input_process.
fn bhumi_scancode_process(raw, n, out, max_ev): i64 {
    var w = 0;
    var i = 0;
    var ext = 0;
    while ((i < n) && (w < max_ev)) {
        var b = load8(raw + i);
        i = i + 1;
        if (b == 0xE0) { ext = 1; }
        if (b == 0xE1) { ext = 0; }                    # Pause/Break lead — ignore
        if ((b != 0xE0) && (b != 0xE1)) {
            var pressed = 1;
            if ((b & 0x80) != 0) { pressed = 0; }
            var code = b & 0x7F;
            var usage = 0;
            if (ext == 1) { usage = _bhumi_set1_ext_to_hid(code); }
            if (ext == 0) { usage = _bhumi_set1_to_hid(code); }
            if (usage != 0) {
                store64(out + (w * 8), bhumi_key_event(pressed, usage));
                w = w + 1;
            }
            ext = 0;
        }
    }
    return w;
}

# Drain pending keyboard input and emit normalized key events. `prev` is the
# caller's held HID report (init with bhumi_input_init; used only on the HID
# host path). `out` receives up to `max_ev` packed events; returns the count.
# On agnos, kbscan#42 yields raw Set-1 scancodes -> bhumi_scancode_process
# (prev unused). On a non-agnos host there is no keyboard (kbscan stub = 0), so
# this returns 0. Nothing pending -> 0.
# ⭐ FOUR FLAT ARMS SINCE 1.3.0, same shape as `src/scanout.cyr`'s seam and for the same reason: a
# `#ifndef CYRIUS_TARGET_AGNOS` arm also matches Linux, so a Linux arm cannot be added beside it
# without two definitions of one function. cycc predefines exactly one of AGNOS/LINUX/MACOS/WIN.
# ⚠ `prev` is used only by the HID-diff path, which is now nobody's — it is kept in the signature
# because it is public API and a consumer's `bhumi_input_init(prev)` buffer is harmless.
#ifdef CYRIUS_TARGET_AGNOS
fn bhumi_input_poll(prev, out, max_ev): i64 {
    var raw[64];   # == BHUMI_INPUT_DRAIN_MAX
    var n = _bhumi_kbscan(&raw, BHUMI_INPUT_DRAIN_MAX);
    if (n <= 0) { return 0; }
    return bhumi_scancode_process(&raw, n, out, max_ev);
}
#endif

#ifdef CYRIUS_TARGET_LINUX
fn bhumi_input_poll(prev, out, max_ev): i64 { return _bhumi_lx_kbd_poll(out, max_ev); }
#endif

#ifdef CYRIUS_TARGET_MACOS
fn bhumi_input_poll(prev, out, max_ev): i64 { return 0; }
#endif

#ifdef CYRIUS_TARGET_WIN
fn bhumi_input_poll(prev, out, max_ev): i64 { return 0; }
#endif

# @public — bhumi output scanout: the kernel handoff (agnos fbinfo#38 / blit#39, Linux fbdev).
#
# This is the second half of the M1 output module — the seam src/output.cyr's
# BhumiFb was built behind. It pushes a finished software framebuffer to the real display.
#
# ⛔ TWO CLAIMS THAT USED TO BE HERE WERE WRONG, one of them from the start:
# · *"the ONLY target-specific code in bhumi"* — false since 0.3.0. `src/kbscan.cyr` and
#   `src/ptrscan.cyr` each carry their own kernel seam. This file is the only target-specific
#   **output** code, which is a different and much smaller claim.
# · *"Everything but the two thin syscall wrappers is portable"* — true when the only other arm
#   returned -1, and no longer true as stated: the Linux arm (1.2.0, ADR 0003) is real code, not a
#   wrapper. ⭐ The PRINCIPLE survives and is what makes the arms cheap — everything that can be
#   pure IS pure and lives above the seam, so sysfs parsing, struct packing, format derivation and
#   blit clipping are all unit-tested on a host with no framebuffer.
#
# The agnos scanout ABI (verified against agnos kernel/core/syscall.cyr, landed
# agnos 1.51.0 / cyrius stdlib 6.3.34):
#
#   fbinfo(#38)  sys_fbinfo(buf, len) -> bytes written / -1
#     Writes a 24-byte framebuffer-geometry struct (6 u32, little-endian):
#       +0  width         pixels
#       +4  height        pixels
#       +8  pitch         bytes per scanline
#       +12 bpp           bits per pixel (always 32)
#       +16 pixel_format  0 = RGBX (bytes [R,G,B,X]), 1 = BGRX (bytes [B,G,R,X])
#       +20 flags         bit 0 = framebuffer present
#
#   blit(#39)  sys_blit(src, w, h, dstxy) -> 0 / -1
#     Raw-copies a w x h 32bpp block from `src` to the framebuffer. No format
#     conversion — the caller supplies pixels in the byte order fbinfo reports.
#     dstxy packs: x = dstxy & 0xFFFF, y = (dstxy>>16) & 0xFFFF,
#     scale = (dstxy>>32) & 0xFF (the kernel treats scale 0 as 1x). Returns -1
#     only when no framebuffer is present; fully off-screen blits clip to 0/ok.
#
# Format contract: BhumiFb stores XRGB8888 via store32, i.e. memory bytes
# [B,G,R,X] — that IS agnos BGRX (pixel_format 1). So a raw blit is color-
# correct against a BGRX framebuffer; against an RGBX one (pixel_format 0) the
# R and B channels are swapped. Callers check bhumi_output_format_ok() first.
#
# Flat domain module: no stdlib includes (see src/main.cyr). Depends on the
# BhumiFb accessors in src/output.cyr, which precedes it in the include chain.

# ================================================================
# fbinfo geometry struct (24 bytes, 6 u32 LE) + pixel-format values
# ================================================================

enum BhumiFbinfoLayout {
    BHUMI_FBINFO_WIDTH  = 0;
    BHUMI_FBINFO_HEIGHT = 4;
    BHUMI_FBINFO_PITCH  = 8;
    BHUMI_FBINFO_BPP    = 12;
    BHUMI_FBINFO_PXFMT  = 16;
    BHUMI_FBINFO_FLAGS  = 20;
    BHUMI_FBINFO_SIZE   = 24;   # struct byte size (and the query buffer minimum)
}

enum BhumiPxFormat {
    BHUMI_PXFMT_RGBX = 0;   # memory bytes [R,G,B,X]
    BHUMI_PXFMT_BGRX = 1;   # memory bytes [B,G,R,X] — matches BhumiFb's store order
}

# ================================================================
# Pure helpers for the Linux arm — no syscall, no device, host-testable.
#
# ⭐ THE SPLIT IS DELIBERATE, AND THIS FILE ALREADY PAID FOR THE LESSON. `_bhumi_fbinfo_rc` below is
# pure precisely because the agnos 0-vs-24 contract bug should never have needed a hardware burn to
# find. CI has no framebuffer, so everything that does NOT require a device — parsing sysfs, packing
# the 24-byte struct, clipping a blit — lives up here where a unit test can reach it, and the arms
# below stay as close to "just the syscall" as possible.
# ================================================================

# Parse a sysfs `virtual_size` body ("W,H", trailing newline tolerated) into `out+0` / `out+4` as
# u32 LE. -> 0 on success, -1 if malformed.
# ⚠ STRICT ABOUT THE COMMA on purpose: a lone number is a malformed virtual_size, not a width.
# Accepting it would put a 0 height into the struct and scan out nothing, silently.
fn _bhumi_parse_wh(s, n, out): i64 {
    var i = 0;
    var w = 0;
    var wd = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c == 44) { break; }                     # ','
        if (c < 48) { return 0 - 1; }
        if (c > 57) { return 0 - 1; }
        w = w * 10 + (c - 48);
        wd = wd + 1;
        i = i + 1;
    }
    if (wd == 0) { return 0 - 1; }                  # nothing before the comma
    if (i >= n) { return 0 - 1; }                   # no comma at all
    i = i + 1;
    var h = 0;
    var hd = 0;
    while (i < n) {
        var c2 = load8(s + i);
        if (c2 < 48) { break; }                     # newline / NUL terminates
        if (c2 > 57) { break; }
        h = h * 10 + (c2 - 48);
        hd = hd + 1;
        i = i + 1;
    }
    if (hd == 0) { return 0 - 1; }
    store32(out, w);
    store32(out + 4, h);
    return 0;
}

# Parse a sysfs integer body ("10240\n"). -> value, or -1 when there are no leading digits.
fn _bhumi_parse_int(s, n): i64 {
    var i = 0;
    var v = 0;
    var d = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c < 48) { break; }
        if (c > 57) { break; }
        v = v * 10 + (c - 48);
        d = d + 1;
        i = i + 1;
    }
    if (d == 0) { return 0 - 1; }
    return v;
}

# Map fbdev `fb_var_screeninfo` red/blue BIT offsets onto BhumiPxFormat.
# XRGB8888 little-endian stores memory bytes [B,G,R,X] — red at bit 16, blue at bit 0 — which is
# BGRX and is what BhumiFb itself stores. RGBX puts red at bit 0. -> BHUMI_PXFMT_BGRX / _RGBX.
# ⚠ This is the ONLY honest source for the channel order. sysfs publishes geometry but not the
# bitfields, so guessing here would silently swap red and blue on any framebuffer that is not the
# DRM default — a wrong picture rather than an error.
fn _bhumi_pxfmt_of_offsets(red_off, blue_off): i64 {
    if (red_off > blue_off) { return BHUMI_PXFMT_BGRX; }
    return BHUMI_PXFMT_RGBX;
}

# Pack the 24-byte fbinfo struct. `bpp` is BITS per pixel (32), matching the agnos #38 contract —
# ⚠ NOT BhumiFb's `bpp`, which is BYTES (4). The two disagree by design and share a name.
fn _bhumi_fbinfo_fill(info, w, h, pitch, bpp, pxfmt, present): i64 {
    store32(info + BHUMI_FBINFO_WIDTH,  w);
    store32(info + BHUMI_FBINFO_HEIGHT, h);
    store32(info + BHUMI_FBINFO_PITCH,  pitch);
    store32(info + BHUMI_FBINFO_BPP,    bpp);
    store32(info + BHUMI_FBINFO_PXFMT,  pxfmt);
    store32(info + BHUMI_FBINFO_FLAGS,  present & 1);
    return 0;
}

# Rows of an `h`-row blit at `y` that actually land on an `fb_h`-row framebuffer. -> 0..h.
# ⚠ `dstxy` packs x/y UNSIGNED, so there is no negative-origin case to clip; off the bottom -> 0.
fn _bhumi_blit_rows(h, fb_h, y): i64 {
    if (y >= fb_h) { return 0; }
    var avail = fb_h - y;
    if (h < avail) { return h; }
    return avail;
}

# Bytes of each source row that land, for a `w`-px row at `x` on an `fb_w`-px framebuffer (4 B/px).
# -> 0 when fully off the right edge.
fn _bhumi_blit_row_bytes(w, fb_w, x): i64 {
    if (x >= fb_w) { return 0; }
    var avail = fb_w - x;
    if (w < avail) { return w * 4; }
    return avail * 4;
}

# ================================================================
# Kernel seam — the ONLY target-specific code. Exactly one branch compiles.
#
# ⭐ FOUR ARMS SINCE 1.2.0, NOT TWO (ADR 0003). Linux is a real display target now, so the seam is no
# longer "agnos, or a stub for everything else".
# ⛔ THE GUARDS ARE FLAT AND MUST STAY FLAT. cycc predefines exactly one target macro via an
# if/else ladder over WIN -> MACOS -> AGNOS -> LINUX (`cyrius/src/main.cyr:1085-1099`), and its own
# comment states agnos is **NOT** `CYRIUS_TARGET_LINUX` ("no /proc, different syscall numbers"). So
# these four are mutually exclusive by construction. Nested `#ifdef` appears NOWHERE in this
# ecosystem and is not a form the preprocessor is exercised on — do not introduce it here.
# ⚠ macOS and Windows keep the -1 stub deliberately: those platforms have their own desktops and
# bhumi is not competing with them. The stub is a decision, not an omission.
# ================================================================

#ifdef CYRIUS_TARGET_AGNOS
# Real agnos kernel calls. sys_fbinfo/sys_blit are the cyrius stdlib wrappers
# over syscalls #38/#39 (agnos-only; on Linux #38/#39 mean something else, which
# is why these live inside the target #ifdef).
fn _bhumi_kfbinfo(info): i64 { return sys_fbinfo(info, BHUMI_FBINFO_SIZE); }
fn _bhumi_kblit(src, w, h, dstxy): i64 { return sys_blit(src, w, h, dstxy); }
#endif

#ifdef CYRIUS_TARGET_LINUX
# --- Linux fbdev arm (ADR 0003) ----------------------------------------------------------------
#
# ⭐ WHY fbdev IS NOT A COMPROMISE HERE: this seam is ALREADY fbdev-shaped. agnos `#38 fbinfo` is
# `FBIOGET_VSCREENINFO` and agnos `#39 blit` is an mmap + row copy, so the Linux arm is a 1:1 fit
# against the two functions above and the whole portable half of this module is reused unchanged.
# DRM/KMS with dumb buffers is the durable answer and is a SECOND backend behind this same
# interface — it needs buffer-lifetime and page-flip semantics that these two functions cannot
# express, so it is not a prerequisite for pixels.
#
# Geometry comes from **sysfs**, not from an ioctl: `/sys/class/graphics/fb0/{virtual_size,stride,
# bits_per_pixel}` gives every field the 24-byte struct needs, as plain text, with no struct-layout
# risk. The ONE thing sysfs cannot answer is the channel order, so exactly one ioctl
# (`FBIOGET_VSCREENINFO`) is issued for the red/blue bit offsets and nothing else.
#
# ⛔ NO stdlib additions were needed. `sys_open`/`sys_read`/`sys_close` come from `syscalls` and
# `memcpy` from `string`, both already in `[deps].stdlib`. `lib/mmap.cyr` is deliberately NOT used —
# see the MAP_SHARED note below. Keeping the dep list unchanged keeps "flat domain module, no
# stdlib includes" honest.

var BHUMI_LX_O_RDONLY = 0;
var BHUMI_LX_O_RDWR   = 2;
# ⛔⛔ MAP_SHARED (1), **NEVER** MAP_PRIVATE (2). This is the trap in this whole file. The stdlib's
# `mmap_file_rw` (`lib/mmap.cyr:100-104`) passes MAP_PRIVATE, which on a framebuffer gives a
# copy-on-write mapping: every write lands in a private page, the syscall succeeds, no error is
# reported anywhere, and NOTHING EVER APPEARS ON THE SCREEN. That is why this arm calls mmap
# directly instead of reusing the convenience wrapper.
var BHUMI_LX_MAP_SHARED = 1;
var BHUMI_LX_PROT_RW    = 3;              # PROT_READ | PROT_WRITE
# ⚠ Raw numbers, named locally and on purpose. `SYS_IOCTL` resolves to 16 on the Linux arm but agnos
# renumbers the enum and `SYS_KILL` is 16 THERE — the mabda shim ADR records that an `enum
# { SYS_IOCTL = 16 }` "turns every DRM ioctl into a kill() and compiles clean". This arm never
# compiles on agnos, so the collision cannot fire, but the name is pinned here so it stays that way.
var BHUMI_LX_SYS_MMAP  = 9;
var BHUMI_LX_SYS_IOCTL = 16;
# fbdev ABI. `fb_var_screeninfo` is 160 bytes; `red`/`green`/`blue` are `struct fb_bitfield`
# {u32 offset, u32 length, u32 msb_right} at +32 / +44 / +56.
var BHUMI_LX_FBIOGET_VSCREENINFO = 0x4600;
var BHUMI_LX_VSI_SIZE     = 160;
var BHUMI_LX_VSI_RED_OFF  = 32;
var BHUMI_LX_VSI_BLUE_OFF = 56;

var _bhumi_lx_map   = 0;                  # mmap base of /dev/fb0; 0 = not mapped yet
var _bhumi_lx_len   = 0;                  # mapped length in bytes (pitch * height)
var _bhumi_lx_pitch = 0;                  # REAL framebuffer stride in bytes — may exceed w*4
var _bhumi_lx_w     = 0;
var _bhumi_lx_h     = 0;
var _bhumi_lx_fmt   = 0;
var _bhumi_lx_bad   = 0;                  # 1 once open has failed, so we fail fast and stay quiet

# Read a whole small file into `buf`. -> bytes read, or -1.
fn _bhumi_lx_slurp(path, buf, cap): i64 {
    var fd = sys_open(path, BHUMI_LX_O_RDONLY, 0);
    if (fd < 0) { return 0 - 1; }
    var n = sys_read(fd, buf, cap);
    sys_close(fd);
    if (n < 0) { return 0 - 1; }
    return n;
}

# One sysfs integer field. -> value, or -1.
fn _bhumi_lx_sysfs_int(path): i64 {
    var buf[64];
    var n = _bhumi_lx_slurp(path, &buf, 64);
    if (n <= 0) { return 0 - 1; }
    return _bhumi_parse_int(&buf, n);
}

# Channel order for an open fb fd. ⚠ FAILS SOFT to BGRX — the DRM fbdev-emulation default and what
# every amdgpu/i915/nouveau console reports — because a compositor with slightly wrong colours is
# far more useful than one that refuses to start, and the geometry is already known good by here.
fn _bhumi_lx_pxfmt(fd): i64 {
    var vsi[160];
    var z = 0;
    while (z < BHUMI_LX_VSI_SIZE) { store8(&vsi + z, 0); z = z + 1; }
    if (syscall(BHUMI_LX_SYS_IOCTL, fd, BHUMI_LX_FBIOGET_VSCREENINFO, &vsi) < 0) {
        return BHUMI_PXFMT_BGRX;
    }
    return _bhumi_pxfmt_of_offsets(load32(&vsi + BHUMI_LX_VSI_RED_OFF),
                                   load32(&vsi + BHUMI_LX_VSI_BLUE_OFF));
}

# Open + map /dev/fb0 once, caching geometry. -> 0 on success, -1 otherwise. Idempotent, and
# latches failure so a headless box (CI) pays one failed open per process, not one per frame.
fn _bhumi_lx_open(): i64 {
    if (_bhumi_lx_map != 0) { return 0; }
    if (_bhumi_lx_bad == 1) { return 0 - 1; }
    _bhumi_lx_bad = 1;                    # cleared only on the success path below
    var wh[64];
    var n = _bhumi_lx_slurp("/sys/class/graphics/fb0/virtual_size", &wh, 64);
    if (n <= 0) { return 0 - 1; }
    var pair[8];
    if (_bhumi_parse_wh(&wh, n, &pair) != 0) { return 0 - 1; }
    var w = load32(&pair);
    var h = load32(&pair + 4);
    if (w <= 0) { return 0 - 1; }
    if (h <= 0) { return 0 - 1; }
    var pitch = _bhumi_lx_sysfs_int("/sys/class/graphics/fb0/stride");
    if (pitch <= 0) { return 0 - 1; }
    # ⛔ 32bpp ONLY. bhumi's whole pixel contract is XRGB8888 and `bhumi_output_present` does a raw
    # 32bpp copy — refusing here is the honest answer for a 16bpp console, not something to convert.
    if (_bhumi_lx_sysfs_int("/sys/class/graphics/fb0/bits_per_pixel") != 32) { return 0 - 1; }
    var fd = sys_open("/dev/fb0", BHUMI_LX_O_RDWR, 0);
    if (fd < 0) { return 0 - 1; }         # not present, or no `video` group / not a VT
    var fmt = _bhumi_lx_pxfmt(fd);
    var len = pitch * h;
    var base = syscall(BHUMI_LX_SYS_MMAP, 0, len, BHUMI_LX_PROT_RW, BHUMI_LX_MAP_SHARED, fd, 0);
    # ⚠ The mapping outlives the fd on Linux, so the descriptor is released immediately — a
    # compositor holding /dev/fb0 open for its whole run blocks nothing, but leaking it would.
    sys_close(fd);
    # mmap reports failure as -errno in [-4095, -1]; every real user mapping is a positive address.
    if (base <= 0) { return 0 - 1; }
    _bhumi_lx_map   = base;
    _bhumi_lx_len   = len;
    _bhumi_lx_pitch = pitch;
    _bhumi_lx_w     = w;
    _bhumi_lx_h     = h;
    _bhumi_lx_fmt   = fmt;
    _bhumi_lx_bad   = 0;
    return 0;
}

# Copy one row 8 bytes at a time, with a 4/1-byte tail.
# ⛔ NOT `memcpy` — the stdlib's is a BYTE loop (`lib/string.cyr:55-62`), and a 2560x1440 present is
# 14.7 MB, i.e. 14.7 MILLION iterations per frame. aethersafha already measured this exact class of
# per-pixel overhead at 12.72 ns/px against 1.03 ns/px for a flat row walk, a 12.3x difference for
# byte-identical stores. A scanout path is the last place to pay it.
fn _bhumi_lx_row(d, s, n): i64 {
    var i = 0;
    var n8 = n - (n & 7);
    while (i < n8) { store64(d + i, load64(s + i)); i = i + 8; }
    while (i < n) { store8(d + i, load8(s + i)); i = i + 1; }
    return 0;
}

fn _bhumi_kfbinfo(info): i64 {
    if (_bhumi_lx_open() != 0) { return 0 - 1; }
    # 0-ok, matching agnos #38 — `_bhumi_fbinfo_rc` is the single place that maps it to the
    # published 24. Returning 24 from here would double-translate.
    return _bhumi_fbinfo_fill(info, _bhumi_lx_w, _bhumi_lx_h, _bhumi_lx_pitch, 32, _bhumi_lx_fmt, 1);
}

fn _bhumi_kblit(src, w, h, dstxy): i64 {
    if (src == 0) { return 0 - 1; }
    if (_bhumi_lx_open() != 0) { return 0 - 1; }
    var x = dstxy & 0xFFFF;
    var y = (dstxy >> 16) & 0xFFFF;
    # ⚠ scale = (dstxy >> 32) & 0xFF is accepted and IGNORED: agnos treats 0 as 1x and every caller
    # in the tree passes 0. Implementing a scaler silently would be worse than not having one.
    var rows = _bhumi_blit_rows(h, _bhumi_lx_h, y);
    var rowb = _bhumi_blit_row_bytes(w, _bhumi_lx_w, x);
    # A fully off-screen blit clips to 0/ok — the documented agnos behaviour, matched deliberately
    # so a window dragged past the edge does not read as a scanout failure.
    if (rows == 0) { return 0; }
    if (rowb == 0) { return 0; }
    var srcpitch = w * 4;
    var r = 0;
    while (r < rows) {
        _bhumi_lx_row(_bhumi_lx_map + (y + r) * _bhumi_lx_pitch + x * 4, src + r * srcpitch, rowb);
        r = r + 1;
    }
    return 0;
}
#endif

#ifdef CYRIUS_TARGET_MACOS
# macOS has its own desktop and bhumi is not competing with it — see the seam banner above.
fn _bhumi_kfbinfo(info): i64 { return 0 - 1; }
fn _bhumi_kblit(src, w, h, dstxy): i64 { return 0 - 1; }
#endif

#ifdef CYRIUS_TARGET_WIN
# Windows (and EFI, which also predefines CYRIUS_TARGET_WIN) — same reasoning as macOS.
fn _bhumi_kfbinfo(info): i64 { return 0 - 1; }
fn _bhumi_kblit(src, w, h, dstxy): i64 { return 0 - 1; }
#endif

# ================================================================
# fbinfo accessors (pure, portable, host-testable over a 24-byte buffer)
# ================================================================

fn bhumi_fbinfo_width(info): i64    { return load32(info + BHUMI_FBINFO_WIDTH); }
fn bhumi_fbinfo_height(info): i64   { return load32(info + BHUMI_FBINFO_HEIGHT); }
fn bhumi_fbinfo_pitch(info): i64    { return load32(info + BHUMI_FBINFO_PITCH); }
fn bhumi_fbinfo_bpp(info): i64      { return load32(info + BHUMI_FBINFO_BPP); }
fn bhumi_fbinfo_pxformat(info): i64 { return load32(info + BHUMI_FBINFO_PXFMT); }
fn bhumi_fbinfo_present(info): i64  { return load32(info + BHUMI_FBINFO_FLAGS) & 1; }

# ================================================================
# Public API
# ================================================================

# Query framebuffer geometry into `info` (a buffer of >= BHUMI_FBINFO_SIZE
# bytes). Returns bytes written (24) on success, or -1 if `info` is null, on a
# non-agnos host, or when the kernel framebuffer is unavailable. On success,
# read fields with the bhumi_fbinfo_* accessors.
# _bhumi_fbinfo_rc(rc) — map the kernel's return onto this module's published contract.
# Pure and free of `#ifdef` ON PURPOSE: it is the exact half of the bug below that a host can test,
# and the half a burn should never have had to find.
fn _bhumi_fbinfo_rc(rc): i64 {
    if (rc < 0) { return 0 - 1; }
    return BHUMI_FBINFO_SIZE;
}

# ⛔ THE KERNEL AND THIS FUNCTION'S DOCUMENTED CONTRACT DISAGREE, AND THIS PASSED THE DISAGREEMENT
# THROUGH FOR EVERY agnos CALLER. agnos `#38 fbinfo` returns **0 on success** (the band's usual
# 0-ok convention, `kernel/core/syscall.cyr` — it fills the struct and returns 0), while the doc
# above promises "bytes written (24)". `return _bhumi_kfbinfo(info)` handed the caller a 0.
#
# ⛔ EVERY CALLER IN THE ECOSYSTEM TESTS `== BHUMI_FBINFO_SIZE`, so every one of them read a
# successful query as a failure: aethersafha's `ae_query_geometry` silently fell back to its
# hardcoded 1280x720 on real hardware, and `programs/scanout-demo` + `programs/backend-demo` would
# never print geometry on agnos either. The compositor's whole 0.10.0 "sized 1.6x wrong" fix — the
# one that exists because a 1280x720 desktop on an 800x600 surface silently shows its top-left
# corner — therefore never took effect on iron. Found on the 2026-08-02 archaemenid burn, where the
# kernel printed `800x600` two lines above the compositor printing `1280 / 720`.
#
# ⚠ INVISIBLE OFF agnos, WHICH IS WHY IT SURVIVED. On a host `_bhumi_kfbinfo` returns -1, which is
# also `!= 24`, so the fallback is correct there and every host test agrees. Only the agnos arm was
# wrong, and only a burn could show it.
#
# The translation now happens HERE, in the portable half, so exactly one place knows the kernel's
# convention and the published contract is what callers actually get.
fn bhumi_output_query(info): i64 {
    if (info == 0) { return 0 - 1; }
    return _bhumi_fbinfo_rc(_bhumi_kfbinfo(info));
}

# Whether a BhumiFb's pixel byte order matches what the framebuffer expects.
# BhumiFb stores XRGB8888 -> memory bytes [B,G,R,X] == BGRX (1), so a raw blit
# is color-correct iff the framebuffer reports BGRX. Returns 1 if a raw present
# is correct, 0 if channels would need swapping (framebuffer is RGBX).
fn bhumi_output_format_ok(info): i64 {
    if (bhumi_fbinfo_pxformat(info) == BHUMI_PXFMT_BGRX) { return 1; }
    return 0;
}

# Scan out framebuffer `fb` to the display at the top-left origin, unscaled.
# dstxy = 0 -> x=0, y=0, scale=0 (kernel treats 0 as 1x). Returns 0 on success,
# or -1 if `fb` is null or there is no framebuffer to scan out (non-agnos host,
# or the agnos framebuffer is not up). Performs a raw 32bpp copy with no
# conversion — verify byte order with bhumi_output_format_ok() first.
fn bhumi_output_present(fb): i64 {
    if (fb == 0) { return 0 - 1; }
    return _bhumi_kblit(bhumi_fb_pixels(fb), bhumi_fb_width(fb), bhumi_fb_height(fb), 0);
}

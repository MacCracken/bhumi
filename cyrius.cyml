[package]
name = "bhumi"
version = "${file:VERSION}"
description = "bhumi — sovereign userland platform backend for the Aethersafha compositor (output/input/seat against the agnos | linux kernels)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.5.20"

[build]
entry = "programs/smoke.cyr"
output = "build/bhumi-smoke"

[lib]
# Domain modules, concatenated (in order) by `cyrius distlib` into
# dist/bhumi.cyr. src/main.cyr is the in-tree convenience entry that
# includes these for smoke.cyr + tests — intentionally NOT listed here,
# else its module bodies would duplicate in the dist bundle.
modules = ["src/output.cyr", "src/scanout.cyr", "src/pattern.cyr", "src/input.cyr", "src/kbscan.cyr", "src/ptrscan.cyr", "src/seat.cyr", "src/backend.cyr"]

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "fnptr"]

# bhumi test suite
# Stdlib auto-included via cyrius.cyml. src/main.cyr is source-included
# so the test can name output.cyr's constants (BHUMI_FMT_*, ...): under
# `cyrius test` the [lib].modules are linked (functions become global
# symbols) but their enum/var constants are only visible to a file that
# source-includes the module.
include "src/main.cyr"

# Stub Ed25519 verifier for the bhumi_cap_verify hook test — stands in for
# sigil's ed25519_verify(pk, msg, msg_len, sig). "Valid" iff pubkey[0]==0xCD
# and sig[0]==0xAB, so the test can drive good/bad key and good/bad signature.
fn _test_ed_verify(pk, msg, msg_len, sig): i64 {
    if (load8(pk) != 0xCD) { return 0; }
    if (load8(sig) != 0xAB) { return 0; }
    return 1;
}

fn main() {
    alloc_init();
    test_group("smoke");
    assert(1, "true is true");
    assert_eq(1 + 1, 2, "math works");

    # ----- output.cyr — pixel packing -----------------------------
    test_group("output.cyr — bhumi_xrgb pack");
    assert_eq(bhumi_xrgb(0x12, 0x34, 0x56), 0x123456, "rgb packs to XRGB8888");
    assert_eq(bhumi_xrgb(0, 0, 0), 0, "black is 0");
    assert_eq(bhumi_xrgb(0xFF, 0xFF, 0xFF), 0xFFFFFF, "white is 0xFFFFFF");
    assert_eq(bhumi_xrgb(0x1FF, 0x1FF, 0x1FF), 0xFFFFFF, "channels mask to 8 bits");

    # ----- output.cyr — framebuffer construction ------------------
    test_group("output.cyr — bhumi_fb_new geometry");
    var fb = bhumi_fb_new(4, 3);
    assert_neq(fb, 0, "4x3 fb allocates");
    assert_eq(bhumi_fb_width(fb),  4,  "width");
    assert_eq(bhumi_fb_height(fb), 3,  "height");
    assert_eq(bhumi_fb_bpp(fb),    4,  "bpp = 4 (XRGB8888)");
    assert_eq(bhumi_fb_pitch(fb),  16, "pitch = width * bpp");
    assert_eq(bhumi_fb_size(fb),   48, "size = pitch * height");
    assert_eq(bhumi_fb_format(fb), BHUMI_FMT_XRGB8888, "format XRGB8888");

    test_group("output.cyr — bhumi_fb_new rejects bad dims");
    assert_eq(bhumi_fb_new(0, 3),  0, "zero width rejected");
    assert_eq(bhumi_fb_new(4, 0),  0, "zero height rejected");
    assert_eq(bhumi_fb_new(-1, 3), 0, "negative width rejected");
    assert_eq(bhumi_fb_new(4, -1), 0, "negative height rejected");
    assert_eq(bhumi_fb_new(BHUMI_FB_MAX_DIM + 1, 1), 0, "over-max width rejected");

    # ----- output.cyr — set / get round-trip + bounds -------------
    test_group("output.cyr — bhumi_fb_set / get");
    var red = bhumi_xrgb(0xFF, 0x00, 0x00);
    assert_eq(bhumi_fb_set(fb, 0, 0, red), 0, "set (0,0) ok");
    assert_eq(bhumi_fb_get(fb, 0, 0), red, "get (0,0) round-trips");
    assert_eq(bhumi_fb_set(fb, 3, 2, red), 0, "set corner (3,2) ok");
    assert_eq(bhumi_fb_get(fb, 3, 2), red, "get corner (3,2) round-trips");
    # Neighbor untouched — writes don't bleed across the pitch.
    assert_eq(bhumi_fb_get(fb, 1, 0), 0, "adjacent pixel untouched");
    # Out-of-bounds is rejected (-1), never clamped or wrapped.
    assert_eq(bhumi_fb_set(fb, 4, 0, red), -1, "set x==width rejected");
    assert_eq(bhumi_fb_set(fb, 0, 3, red), -1, "set y==height rejected");
    assert_eq(bhumi_fb_get(fb, -1, 0), -1, "get negative x rejected");

    # ----- output.cyr — clear -------------------------------------
    test_group("output.cyr — bhumi_fb_clear");
    var blue = bhumi_xrgb(0x00, 0x00, 0xFF);
    bhumi_fb_clear(fb, blue);
    assert_eq(bhumi_fb_get(fb, 0, 0), blue, "clear fills (0,0)");
    assert_eq(bhumi_fb_get(fb, 3, 2), blue, "clear fills last pixel");
    assert_eq(bhumi_fb_get(fb, 2, 1), blue, "clear fills interior");

    # ----- pattern.cyr — bar color table + index ------------------
    test_group("pattern.cyr — bhumi_bar_color / bhumi_bar_index");
    assert_eq(bhumi_bar_color(0), bhumi_xrgb(0xFF, 0xFF, 0xFF), "bar 0 white");
    assert_eq(bhumi_bar_color(1), bhumi_xrgb(0xFF, 0xFF, 0x00), "bar 1 yellow");
    assert_eq(bhumi_bar_color(3), bhumi_xrgb(0x00, 0xFF, 0x00), "bar 3 green");
    assert_eq(bhumi_bar_color(6), bhumi_xrgb(0x00, 0x00, 0xFF), "bar 6 blue");
    assert_eq(bhumi_bar_color(7), 0, "out-of-range bar is black");
    # 14 wide, 7 bars -> 2px per bar: bar = x/2.
    assert_eq(bhumi_bar_index(14, 0),  0, "x=0 -> bar 0");
    assert_eq(bhumi_bar_index(14, 1),  0, "x=1 -> bar 0");
    assert_eq(bhumi_bar_index(14, 2),  1, "x=2 -> bar 1");
    assert_eq(bhumi_bar_index(14, 13), 6, "x=13 -> bar 6 (last)");

    # ----- pattern.cyr — bhumi_pattern_bars -----------------------
    test_group("pattern.cyr — bhumi_pattern_bars");
    var bars = bhumi_fb_new(14, 4);   # 2px per bar
    assert_neq(bars, 0, "14x4 fb allocates");
    assert_eq(bhumi_pattern_bars(bars), 0, "bars ok");
    assert_eq(bhumi_fb_get(bars, 0, 0),  bhumi_bar_color(0), "col 0 white");
    assert_eq(bhumi_fb_get(bars, 2, 0),  bhumi_bar_color(1), "col 2 yellow");
    assert_eq(bhumi_fb_get(bars, 6, 0),  bhumi_bar_color(3), "col 6 green");
    assert_eq(bhumi_fb_get(bars, 13, 0), bhumi_bar_color(6), "col 13 blue");
    # Bars are column-defined: every row is identical.
    assert_eq(bhumi_fb_get(bars, 6, 3), bhumi_fb_get(bars, 6, 0), "bars row-invariant");
    assert_eq(bhumi_pattern_bars(0), -1, "null fb rejected");

    # ----- pattern.cyr — bhumi_pattern_xor ------------------------
    test_group("pattern.cyr — bhumi_pattern_xor");
    var xg = bhumi_fb_new(4, 4);
    assert_neq(xg, 0, "4x4 fb allocates");
    assert_eq(bhumi_pattern_xor(xg), 0, "xor ok");
    assert_eq(bhumi_xor_value(3, 1), 2, "xor value 3^1 = 2");
    assert_eq(bhumi_fb_get(xg, 0, 0), 0, "(0,0): 0^0=0 -> black");
    assert_eq(bhumi_fb_get(xg, 1, 0), bhumi_xrgb(1, 1, 1), "(1,0): 1^0=1 -> gray 1");
    assert_eq(bhumi_fb_get(xg, 0, 1), bhumi_fb_get(xg, 1, 0), "xor symmetric (0,1)==(1,0)");
    assert_eq(bhumi_fb_get(xg, 3, 1), bhumi_xrgb(2, 2, 2), "(3,1): 3^1=2 -> gray 2");
    assert_eq(bhumi_pattern_xor(0), -1, "null fb rejected");

    # ----- scanout.cyr — fbinfo struct accessors ------------------
    # Synthesize the 24-byte kernel geometry struct and verify each field is
    # parsed at the right offset (this is the agnos ABI, checked host-side).
    test_group("scanout.cyr — fbinfo accessors");
    var info[24];
    store32(&info + BHUMI_FBINFO_WIDTH,  1920);
    store32(&info + BHUMI_FBINFO_HEIGHT, 1080);
    store32(&info + BHUMI_FBINFO_PITCH,  7680);
    store32(&info + BHUMI_FBINFO_BPP,    32);
    store32(&info + BHUMI_FBINFO_PXFMT,  BHUMI_PXFMT_BGRX);
    store32(&info + BHUMI_FBINFO_FLAGS,  1);
    assert_eq(BHUMI_FBINFO_SIZE, 24, "fbinfo struct is 24 bytes");
    assert_eq(bhumi_fbinfo_width(&info),    1920, "width  @ +0");
    assert_eq(bhumi_fbinfo_height(&info),   1080, "height @ +4");
    assert_eq(bhumi_fbinfo_pitch(&info),    7680, "pitch  @ +8");
    assert_eq(bhumi_fbinfo_bpp(&info),      32,   "bpp    @ +12");
    assert_eq(bhumi_fbinfo_pxformat(&info), 1,    "pxfmt  @ +16");
    assert_eq(bhumi_fbinfo_present(&info),  1,    "present flag = bit 0 of +20");

    # ----- scanout.cyr — format compatibility ---------------------
    test_group("scanout.cyr — bhumi_output_format_ok");
    assert_eq(bhumi_output_format_ok(&info), 1, "BGRX framebuffer matches BhumiFb");
    store32(&info + BHUMI_FBINFO_PXFMT, BHUMI_PXFMT_RGBX);
    assert_eq(bhumi_output_format_ok(&info), 0, "RGBX framebuffer needs channel swap");
    # present flag reads only bit 0: an even flags word is "not present".
    store32(&info + BHUMI_FBINFO_FLAGS, 2);
    assert_eq(bhumi_fbinfo_present(&info), 0, "flags=2 -> present bit clear");

    # ----- scanout.cyr — present / query guards -------------------
    # The null guards short-circuit before the kernel seam on every target.
    test_group("scanout.cyr — present / query");
    assert_eq(bhumi_output_present(0), -1, "present null fb rejected");
    assert_eq(bhumi_output_query(0),  -1, "query null buf rejected");
    var sfb = bhumi_fb_new(8, 8);
    assert_neq(sfb, 0, "8x8 fb allocates");

    # ⛔⛔ THERE IS NO `bhumi_output_present(sfb)` ASSERTION HERE ANY MORE, AND THAT IS DELIBERATE.
    # Two assertions used to live here — "present -1 on non-agnos host (no framebuffer)" and "query
    # -1 on non-agnos host" — and 1.2.0's Linux fbdev arm turned both into FAILURES BY SUCCEEDING:
    # query answered 24 and present answered 0, because it had genuinely scanned out. ⚠ The failure
    # was the mild half. The real problem is that `present` on a box with a live `/dev/fb0` **writes
    # to the physical display**, so running the unit suite painted an 8x8 block onto the operator's
    # screen. A unit test must not have a side effect you can SEE. The device path belongs to
    # `programs/scanout-demo`, which you run on purpose; the pure half is covered below.
    #
    # `query` is kept but asserted ENVIRONMENT-TOLERANTLY: it reads geometry and paints nothing, and
    # its answer legitimately differs between a dev box with a framebuffer and CI without one.
    # Asserting a single value here is what made the old test wrong — so assert the CONTRACT instead:
    # either "unavailable", or a complete and self-consistent struct.
    var qrc = bhumi_output_query(&info);
    assert(((qrc == -1) || (qrc == BHUMI_FBINFO_SIZE)) == 1, "query answers -1 or 24, never anything else");
    if (qrc == BHUMI_FBINFO_SIZE) {
        assert(bhumi_fbinfo_width(&info)  > 0, "live fb: width is positive");
        assert(bhumi_fbinfo_height(&info) > 0, "live fb: height is positive");
        assert_eq(bhumi_fbinfo_bpp(&info), 32, "live fb: 32 bpp (the only format this seam accepts)");
        assert(bhumi_fbinfo_pitch(&info) >= (bhumi_fbinfo_width(&info) * 4), "live fb: pitch covers a row");
        assert_eq(bhumi_fbinfo_present(&info), 1, "live fb: present bit set");
    }

    # ----- scanout.cyr — the Linux arm's PURE half ----------------
    # Everything the fbdev backend does that does NOT need a device. This is the half CI can run,
    # and the half that would otherwise only be checked by looking at a screen.
    test_group("scanout.cyr — sysfs parsing (pure)");
    var wh[8];
    assert_eq(_bhumi_parse_wh("2560,1440\n", 10, &wh), 0, "virtual_size parses");
    assert_eq(load32(&wh),     2560, "  -> width");
    assert_eq(load32(&wh + 4), 1440, "  -> height");
    assert_eq(_bhumi_parse_wh("8,8", 3, &wh), 0, "no trailing newline is fine");
    assert_eq(load32(&wh),     8, "  -> width");
    assert_eq(load32(&wh + 4), 8, "  -> height");
    # ⛔ A LONE NUMBER MUST BE REJECTED, not read as a width. Accepting it would store height 0 and
    # scan out nothing at all, silently — the exact shape of failure this module exists to avoid.
    assert_eq(_bhumi_parse_wh("2560", 4, &wh),   -1, "missing comma rejected");
    assert_eq(_bhumi_parse_wh("2560,", 5, &wh),  -1, "missing height rejected");
    assert_eq(_bhumi_parse_wh(",1440", 5, &wh),  -1, "missing width rejected");
    assert_eq(_bhumi_parse_wh("x,1440", 6, &wh), -1, "non-numeric width rejected");
    assert_eq(_bhumi_parse_wh("", 0, &wh),       -1, "empty rejected");

    assert_eq(_bhumi_parse_int("10240\n", 6), 10240, "stride parses");
    assert_eq(_bhumi_parse_int("32\n", 3),       32, "bits_per_pixel parses");
    assert_eq(_bhumi_parse_int("0\n", 2),         0, "zero is a value, not an error");
    assert_eq(_bhumi_parse_int("\n", 1),         -1, "no digits -> -1");
    assert_eq(_bhumi_parse_int("abc", 3),        -1, "non-numeric -> -1");

    test_group("scanout.cyr — pixel format from fb_bitfield offsets (pure)");
    # XRGB8888 LE: red at bit 16, blue at bit 0 -> bytes [B,G,R,X] -> BGRX, what BhumiFb stores.
    assert_eq(_bhumi_pxfmt_of_offsets(16, 0), BHUMI_PXFMT_BGRX, "red>blue -> BGRX");
    assert_eq(_bhumi_pxfmt_of_offsets(0, 16), BHUMI_PXFMT_RGBX, "red<blue -> RGBX");

    test_group("scanout.cyr — fbinfo_fill (pure)");
    var fi[24];
    _bhumi_fbinfo_fill(&fi, 2560, 1440, 10240, 32, BHUMI_PXFMT_BGRX, 1);
    assert_eq(bhumi_fbinfo_width(&fi),    2560,  "fill -> width");
    assert_eq(bhumi_fbinfo_height(&fi),   1440,  "fill -> height");
    assert_eq(bhumi_fbinfo_pitch(&fi),    10240, "fill -> pitch");
    assert_eq(bhumi_fbinfo_bpp(&fi),      32,    "fill -> bpp is BITS, not bytes");
    assert_eq(bhumi_fbinfo_pxformat(&fi), 1,     "fill -> pxfmt");
    assert_eq(bhumi_fbinfo_present(&fi),  1,     "fill -> present");
    assert_eq(bhumi_output_format_ok(&fi), 1,    "a BGRX fb takes a raw BhumiFb blit");
    # A filled struct must round-trip through the SAME accessors the agnos arm feeds, or the two
    # arms disagree about the struct while both looking correct.
    _bhumi_fbinfo_fill(&fi, 800, 600, 3200, 32, BHUMI_PXFMT_RGBX, 0);
    assert_eq(bhumi_fbinfo_present(&fi),   0, "present=0 clears the flag");
    assert_eq(bhumi_output_format_ok(&fi), 0, "an RGBX fb needs channel swapping");

    test_group("scanout.cyr — blit clipping (pure)");
    assert_eq(_bhumi_blit_rows(100, 1440, 0),     100,  "fully on-screen -> all rows");
    assert_eq(_bhumi_blit_rows(100, 1440, 1400),  40,   "off the bottom -> clipped");
    assert_eq(_bhumi_blit_rows(100, 1440, 1440),  0,    "origin at the bottom edge -> 0 rows");
    assert_eq(_bhumi_blit_rows(100, 1440, 9999),  0,    "origin past the bottom -> 0 rows");
    assert_eq(_bhumi_blit_row_bytes(64, 2560, 0),    256, "fully on-screen -> w*4 bytes");
    assert_eq(_bhumi_blit_row_bytes(64, 2560, 2528), 128, "off the right -> clipped to the edge");
    assert_eq(_bhumi_blit_row_bytes(64, 2560, 2560), 0,   "origin at the right edge -> 0 bytes");
    # ⚠ The clip must be exact, not approximate: one pixel too many writes past the end of a row and
    # into the NEXT row's left edge, which looks like tearing rather than like a bug.
    assert_eq(_bhumi_blit_row_bytes(1, 2560, 2559), 4, "last pixel of a row still lands");

    # ⛔ THE agnos RETURN CONVENTION — the half of the 2026-08-02 iron bug a host CAN test.
    # `#38 fbinfo` fills the struct and returns **0**, not the 24 this module's doc promises, and
    # bhumi used to pass that 0 straight out. Every consumer tests `== BHUMI_FBINFO_SIZE`, so a
    # successful query read as a failure and aethersafha fell back to a hardcoded 1280x720 on an
    # 800x600 panel — for the entire life of the fix that existed to prevent exactly that.
    # ⚠ Untestable through bhumi_output_query itself off agnos (the host arm returns -1 either way),
    # which is precisely why the mapping is factored out where it can be asserted directly.
    assert_eq(_bhumi_fbinfo_rc(0),  BHUMI_FBINFO_SIZE, "kernel 0-ok maps to the documented 24");
    assert_eq(_bhumi_fbinfo_rc(24), BHUMI_FBINFO_SIZE, "an already-24 return stays 24");
    assert_eq(_bhumi_fbinfo_rc(0 - 1), -1, "kernel -1 stays a failure");

    # ----- edge cases ---------------------------------------------
    test_group("edge cases");
    # 1x1 framebuffer — the smallest valid surface.
    var one = bhumi_fb_new(1, 1);
    assert_neq(one, 0, "1x1 fb allocates");
    assert_eq(bhumi_fb_pitch(one), 4, "1x1 pitch = 4");
    assert_eq(bhumi_fb_size(one),  4, "1x1 size = 4");
    assert_eq(bhumi_fb_set(one, 0, 0, 0x123456), 0, "1x1 set (0,0) ok");
    assert_eq(bhumi_fb_get(one, 0, 0), 0x123456, "1x1 get round-trip");
    assert_eq(bhumi_fb_set(one, 1, 0, 0), -1, "1x1 (1,0) OOB");
    assert_eq(bhumi_fb_set(one, 0, 1, 0), -1, "1x1 (0,1) OOB");

    # Max-dim boundary is accepted for a thin buffer (16384x1 = 64 KiB).
    var mx = bhumi_fb_new(BHUMI_FB_MAX_DIM, 1);
    assert_neq(mx, 0, "max-dim x 1 allocates");
    assert_eq(bhumi_fb_width(mx), BHUMI_FB_MAX_DIM, "max-dim width");

    # Bars on a width not divisible by 7: bar = (x*7)/w still covers [0,6].
    var b10 = bhumi_fb_new(10, 2);
    bhumi_pattern_bars(b10);
    assert_eq(bhumi_bar_index(10, 2), 1, "10-wide col 2 -> bar 1");
    assert_eq(bhumi_fb_get(b10, 0, 0), bhumi_bar_color(0), "10-wide col 0 = white");
    assert_eq(bhumi_fb_get(b10, 9, 0), bhumi_bar_color(6), "10-wide col 9 = blue");

    # fbinfo present flag reads ONLY bit 0, whatever the high bits are.
    var info2[24];
    store32(&info2 + BHUMI_FBINFO_FLAGS, 0xFFFFFFFE);
    assert_eq(bhumi_fbinfo_present(&info2), 0, "0xFFFFFFFE -> present 0");
    store32(&info2 + BHUMI_FBINFO_FLAGS, 0xFFFFFFFF);
    assert_eq(bhumi_fbinfo_present(&info2), 1, "0xFFFFFFFF -> present 1");

    # A framebuffer sized from queried geometry (the demo's path).
    store32(&info2 + BHUMI_FBINFO_WIDTH,  64);
    store32(&info2 + BHUMI_FBINFO_HEIGHT, 48);
    var qfb = bhumi_fb_new(bhumi_fbinfo_width(&info2), bhumi_fbinfo_height(&info2));
    assert_neq(qfb, 0, "fb from queried geometry allocates");
    assert_eq(bhumi_fb_width(qfb),  64, "geometry-sized width");
    assert_eq(bhumi_fb_height(qfb), 48, "geometry-sized height");

    # ----- input.cyr — USB HID key event pack ---------------------
    test_group("input.cyr — bhumi_key_event");
    assert_eq(bhumi_key_pressed(bhumi_key_event(1, BHUMI_HID_A)), 1,       "press: pressed=1");
    assert_eq(bhumi_key_usage(bhumi_key_event(1, BHUMI_HID_A)), BHUMI_HID_A, "press: usage 0x04");
    assert_eq(bhumi_key_pressed(bhumi_key_event(0, BHUMI_HID_LSHIFT)), 0,  "release: pressed=0");
    assert_eq(bhumi_key_usage(bhumi_key_event(0, BHUMI_HID_LSHIFT)), 0xE1, "usage 0xE1 (LShift)");

    # ----- input.cyr — bhumi_kbd_diff (HID report -> events) ------
    test_group("input.cyr — bhumi_kbd_diff key press/release");
    var prev[8];
    var cur[8];
    var evs[64];
    memset(&prev, 0, 8); memset(&cur, 0, 8);

    # Press A: absent -> present in a key slot.
    store8(&cur + BHUMI_HID_REPORT_KEY0, BHUMI_HID_A);
    assert_eq(bhumi_kbd_diff(&prev, &cur, &evs, 8), 1, "A press -> 1 event");
    assert_eq(bhumi_key_pressed(load64(&evs)), 1,          "A press: pressed");
    assert_eq(bhumi_key_usage(load64(&evs)),   BHUMI_HID_A, "A press: usage 0x04");

    # Release A: present -> absent (derived from the state change).
    memset(&prev, 0, 8); store8(&prev + BHUMI_HID_REPORT_KEY0, BHUMI_HID_A);
    memset(&cur, 0, 8);
    assert_eq(bhumi_kbd_diff(&prev, &cur, &evs, 8), 1, "A release -> 1 event");
    assert_eq(bhumi_key_pressed(load64(&evs)), 0,          "A release: not pressed");
    assert_eq(bhumi_key_usage(load64(&evs)),   BHUMI_HID_A, "A release: usage 0x04");

    # Held key stays down while another is added -> only the new key events.
    memset(&prev, 0, 8); store8(&prev + BHUMI_HID_REPORT_KEY0, BHUMI_HID_A);
    memset(&cur, 0, 8);
    store8(&cur + BHUMI_HID_REPORT_KEY0, BHUMI_HID_A);
    store8(&cur + BHUMI_HID_REPORT_KEY0 + 1, 0x05);       # 'B'
    assert_eq(bhumi_kbd_diff(&prev, &cur, &evs, 8), 1, "add B while A held -> 1 event");
    assert_eq(bhumi_key_usage(load64(&evs)), 0x05, "the new key is B");

    # Empty/rollover slots (0x00-0x03) never produce events.
    memset(&prev, 0, 8); memset(&cur, 0, 8);
    store8(&cur + BHUMI_HID_REPORT_KEY0, 0x01);           # ErrorRollOver
    assert_eq(bhumi_kbd_diff(&prev, &cur, &evs, 8), 0, "rollover slot -> no event");

    # ----- input.cyr — bhumi_kbd_diff modifiers -------------------
    test_group("input.cyr — bhumi_kbd_diff modifiers");
    memset(&prev, 0, 8); memset(&cur, 0, 8);
    store8(&cur + BHUMI_HID_REPORT_MODS, 0x02);           # bit 1 = LShift (0xE1)
    assert_eq(bhumi_kbd_diff(&prev, &cur, &evs, 8), 1, "LShift down -> 1 event");
    assert_eq(bhumi_key_pressed(load64(&evs)), 1,    "LShift: press");
    assert_eq(bhumi_key_usage(load64(&evs)),   0xE1, "LShift: usage 0xE1");
    # Release the modifier.
    memset(&prev, 0, 8); store8(&prev + BHUMI_HID_REPORT_MODS, 0x02);
    memset(&cur, 0, 8);
    assert_eq(bhumi_kbd_diff(&prev, &cur, &evs, 8), 1, "LShift up -> 1 event");
    assert_eq(bhumi_key_pressed(load64(&evs)), 0, "LShift: release");

    # Combined: LCtrl + A pressed together -> modifier event first, then key.
    memset(&prev, 0, 8); memset(&cur, 0, 8);
    store8(&cur + BHUMI_HID_REPORT_MODS, 0x01);           # bit 0 = LCtrl (0xE0)
    store8(&cur + BHUMI_HID_REPORT_KEY0, BHUMI_HID_A);
    assert_eq(bhumi_kbd_diff(&prev, &cur, &evs, 8), 2, "Ctrl+A -> 2 events");
    assert_eq(bhumi_key_usage(load64(&evs + 0)), 0xE0,        "event 0: LCtrl (modifier first)");
    assert_eq(bhumi_key_usage(load64(&evs + 8)), BHUMI_HID_A, "event 1: A");

    # No change -> no events.
    assert_eq(bhumi_kbd_diff(&cur, &cur, &evs, 8), 0, "identical reports -> no events");

    # ----- kbscan.cyr — init + poll (host stub) -------------------
    test_group("kbscan.cyr — bhumi_input_init / poll");
    var pv[8];
    store8(&pv + 0, 0x7F);                                 # dirty it first
    bhumi_input_init(&pv);
    assert_eq(load8(&pv + 0), 0, "init zeroes the prev report");
    var pev[8];
    assert_eq(bhumi_input_poll(&pv, &pev, 1), 0, "poll returns 0 on non-agnos host");

    # ----- kbscan.cyr — bhumi_input_process (report stream) -------
    test_group("kbscan.cyr — bhumi_input_process");
    var pv2[8];
    var rbuf[16];
    var pevs[64];
    bhumi_input_init(&pv2);
    # Two reports in one drained buffer: [A down] then [A held + B down].
    memset(&rbuf, 0, 16);
    store8(&rbuf + BHUMI_HID_REPORT_KEY0, BHUMI_HID_A);
    store8(&rbuf + 8 + BHUMI_HID_REPORT_KEY0, BHUMI_HID_A);
    store8(&rbuf + 8 + BHUMI_HID_REPORT_KEY0 + 1, 0x05);   # 'B'
    assert_eq(bhumi_input_process(&pv2, &rbuf, 16, &pevs, 8), 2, "two reports -> 2 events");
    assert_eq(bhumi_key_pressed(load64(&pevs + 0)), 1,           "ev0 press");
    assert_eq(bhumi_key_usage(load64(&pevs + 0)),   BHUMI_HID_A, "ev0 A");
    assert_eq(bhumi_key_usage(load64(&pevs + 8)),   0x05,        "ev1 B");
    # prev now reflects [A+B]; an empty report releases both.
    var rempty[8];
    memset(&rempty, 0, 8);
    assert_eq(bhumi_input_process(&pv2, &rempty, 8, &pevs, 8), 2, "empty report -> 2 releases");
    assert_eq(bhumi_key_pressed(load64(&pevs + 0)), 0, "release: not pressed");
    # A trailing partial report (n not a multiple of 8) is left unprocessed.
    bhumi_input_init(&pv2);
    memset(&rbuf, 0, 16);
    store8(&rbuf + BHUMI_HID_REPORT_KEY0, BHUMI_HID_A);
    assert_eq(bhumi_input_process(&pv2, &rbuf, 11, &pevs, 8), 1, "11 bytes -> 1 whole report, 3 ignored");

    # ----- seat.cyr — capability scope + expiry -------------------
    test_group("seat.cyr — bhumi_cap");
    var tnow = 1000;
    var capO = bhumi_cap_new(7, BHUMI_DEV_OUTPUT, 0, 1);   # subject 7, output, never expires
    assert_neq(capO, 0, "cap allocates");
    assert_eq(bhumi_cap_subject(capO), 7,                "subject");
    assert_eq(bhumi_cap_devices(capO), BHUMI_DEV_OUTPUT, "devices");
    assert_eq(bhumi_cap_grants(capO, BHUMI_DEV_OUTPUT, tnow), 1, "grants output");
    assert_eq(bhumi_cap_grants(capO, BHUMI_DEV_INPUT,  tnow), 0, "denies ungranted device");
    assert_eq(bhumi_cap_grants(0,    BHUMI_DEV_OUTPUT, tnow), 0, "null cap denies");
    var capE = bhumi_cap_new(7, BHUMI_DEV_OUTPUT, 2000, 1);   # expires at 2000
    assert_eq(bhumi_cap_grants(capE, BHUMI_DEV_OUTPUT, 1999), 1, "valid before expiry");
    assert_eq(bhumi_cap_grants(capE, BHUMI_DEV_OUTPUT, 2000), 0, "expired at expiry");
    assert_eq(bhumi_cap_grants(capE, BHUMI_DEV_OUTPUT, 2001), 0, "expired after");

    # ----- seat.cyr — the gate (active AND capability) ------------
    test_group("seat.cyr — bhumi_seat_can");
    var seatA = bhumi_seat_new(1);
    assert_neq(seatA, 0, "seat allocates");
    assert_eq(bhumi_seat_active(seatA), 0, "new seat starts background");
    assert_eq(bhumi_seat_can(seatA, BHUMI_DEV_OUTPUT, tnow), 0, "background + no cap -> denied");
    bhumi_seat_grant(seatA, capO);
    assert_eq(bhumi_seat_can(seatA, BHUMI_DEV_OUTPUT, tnow), 0, "has cap but background -> denied");
    bhumi_seat_activate(seatA);
    assert_eq(bhumi_seat_can(seatA, BHUMI_DEV_OUTPUT, tnow), 1, "active + cap -> granted");
    assert_eq(bhumi_seat_can(seatA, BHUMI_DEV_INPUT,  tnow), 0, "active but cap lacks input -> denied");
    var capOI = bhumi_cap_new(7, BHUMI_DEV_OUTPUT | BHUMI_DEV_INPUT, 0, 1);
    bhumi_seat_grant(seatA, capOI);
    assert_eq(bhumi_seat_can(seatA, BHUMI_DEV_INPUT, tnow), 1, "output|input cap -> input granted");

    # ----- seat.cyr — hand-off keeps exactly one active ----------
    test_group("seat.cyr — bhumi_seat_handoff");
    var seatB = bhumi_seat_new(2);
    bhumi_seat_grant(seatB, capOI);
    assert_eq(bhumi_seat_can(seatA, BHUMI_DEV_OUTPUT, tnow), 1, "A (fg) can output");
    assert_eq(bhumi_seat_can(seatB, BHUMI_DEV_OUTPUT, tnow), 0, "B (bg) cannot");
    bhumi_seat_handoff(seatA, seatB);
    assert_eq(bhumi_seat_active(seatA), 0, "after handoff A is background");
    assert_eq(bhumi_seat_active(seatB), 1, "after handoff B is foreground");
    assert_eq(bhumi_seat_can(seatA, BHUMI_DEV_OUTPUT, tnow), 0, "A can no longer output");
    assert_eq(bhumi_seat_can(seatB, BHUMI_DEV_OUTPUT, tnow), 1, "B now can output");

    # ----- seat.cyr — device access ONLY through the gate --------
    test_group("seat.cyr — gated present / poll");
    # ⛔⛔ THE AUTHORIZED CASE IS TESTED WITH A **NULL** FB, NOT A REAL ONE, SINCE 1.2.0.
    # This assertion used to read `bhumi_seat_present(seatB, gfb, tnow) == bhumi_output_present(gfb)`,
    # which called the device op TWICE. That was free while every non-agnos target answered -1 without
    # touching anything. With the Linux fbdev arm it became **two live blits onto the operator's
    # screen per test run**, and the assertion still passed — 0 == 0 — so nothing complained.
    # ⇒ Passing 0 keeps the gate under test and takes the device out of it entirely: the gate is
    # checked FIRST (`seat.cyr:203`), so an authorized seat falls through to `bhumi_output_present(0)`,
    # which rejects null before any syscall. Authorized -> -1, denied -> BHUMI_SEAT_DENIED (-2), and
    # the two are distinct, which is the whole property this group exists to prove.
    assert_eq(bhumi_seat_present(seatB, 0, tnow), -1, "authorized present reaches the raw op (which rejects null)");
    assert_eq(bhumi_seat_present(seatA, 0, tnow), BHUMI_SEAT_DENIED, "background seat present -> DENIED (never reaches the op)");
    # And the gate predicate itself, directly — no device in the path at all.
    assert_eq(bhumi_seat_can(seatB, BHUMI_DEV_OUTPUT, tnow), 1, "authorized seat may output");
    assert_eq(bhumi_seat_can(seatA, BHUMI_DEV_OUTPUT, tnow), 0, "background seat may not output");
    var gfb = bhumi_fb_new(8, 8);
    var gprev[8];
    bhumi_input_init(&gprev);
    var gevs[8];
    assert_eq(bhumi_seat_poll(seatB, &gprev, &gevs, 1, tnow), 0, "authorized poll -> 0 events on host (gate passed)");
    assert_eq(bhumi_seat_poll(seatA, &gprev, &gevs, 1, tnow), BHUMI_SEAT_DENIED, "background seat poll -> DENIED");

    # ----- seat.cyr — seat manager (exactly one active) ----------
    test_group("seat.cyr — bhumi_seatmgr");
    var mgr = bhumi_seatmgr_new();
    assert_neq(mgr, 0, "mgr allocates");
    assert_eq(bhumi_seatmgr_count(mgr),  0, "starts empty");
    assert_eq(bhumi_seatmgr_active(mgr), 0, "no foreground");
    var s1 = bhumi_seat_new(10);
    var s2 = bhumi_seat_new(11);
    var s3 = bhumi_seat_new(12);
    assert_eq(bhumi_seatmgr_add(mgr, s1), 0, "add s1");
    assert_eq(bhumi_seatmgr_add(mgr, s2), 0, "add s2");
    assert_eq(bhumi_seatmgr_count(mgr), 2, "count 2");
    assert_eq(bhumi_seatmgr_has(mgr, s1), 1, "has s1");
    assert_eq(bhumi_seatmgr_has(mgr, s3), 0, "s3 not registered");

    # switch to an unregistered seat fails and leaves the foreground unchanged
    assert_eq(bhumi_seatmgr_switch(mgr, s3), -1, "switch to unregistered -> -1");
    assert_eq(bhumi_seatmgr_active(mgr), 0, "foreground unchanged");

    assert_eq(bhumi_seatmgr_switch(mgr, s1), 0, "switch to s1");
    assert_eq(bhumi_seatmgr_active(mgr), s1, "s1 is foreground");
    assert_eq(bhumi_seat_active(s1), 1, "s1 active");
    assert_eq(bhumi_seat_active(s2), 0, "s2 background");

    # switching to s2 must auto-deactivate s1 (single-active invariant)
    assert_eq(bhumi_seatmgr_switch(mgr, s2), 0, "switch to s2");
    assert_eq(bhumi_seat_active(s1), 0, "s1 auto-deactivated");
    assert_eq(bhumi_seat_active(s2), 1, "s2 foreground");
    assert_eq(bhumi_seatmgr_active(mgr), s2, "mgr active = s2");

    bhumi_seatmgr_release(mgr);
    assert_eq(bhumi_seat_active(s2), 0, "release deactivates s2");
    assert_eq(bhumi_seatmgr_active(mgr), 0, "no foreground after release");

    # capacity: fills to BHUMI_SEATMGR_MAX, then rejects
    var mgr2 = bhumi_seatmgr_new();
    var k = 0;
    while (k < BHUMI_SEATMGR_MAX) {
        assert_eq(bhumi_seatmgr_add(mgr2, s1), 0, "add within capacity");
        k = k + 1;
    }
    assert_eq(bhumi_seatmgr_count(mgr2), BHUMI_SEATMGR_MAX, "count == MAX");
    assert_eq(bhumi_seatmgr_add(mgr2, s1), -1, "add beyond MAX -> -1");

    # ----- backend.cyr — the assembled handle + gated frame loop --
    test_group("backend.cyr — bhumi_backend");
    var bcap = bhumi_cap_new(42, BHUMI_DEV_OUTPUT | BHUMI_DEV_INPUT, 0, 1);
    var be = bhumi_backend_open(bcap, 64, 48);
    assert_neq(be, 0, "backend opens");
    assert_eq(bhumi_backend_width(be),  64, "display width");
    assert_eq(bhumi_backend_height(be), 48, "display height");
    assert_neq(bhumi_backend_fb(be), 0, "has a primary framebuffer");
    assert_eq(bhumi_fb_width(bhumi_backend_fb(be)), 64, "primary fb sized to display");
    assert_eq(bhumi_seat_active(bhumi_backend_seat(be)), 1, "backend seat is foreground");

    # Foreground backend: frame-loop ops pass the gate (host returns 0 / raw op).
    var bevs[8];
    assert_eq(bhumi_backend_poll(be, &bevs, 1, 1000), 0, "poll passes the gate (0 on host)");
    # ⛔ `bhumi_backend_present` takes its fb FROM THE BACKEND, so unlike the seat group above there is
    # no null-fb trick available — any authorized call blits for real. Since 1.2.0 the authorized case
    # is therefore asserted on the GATE PREDICATE, which is the only thing this group was ever testing;
    # the old form called the device op twice and painted the screen twice on every `cyrius test`.
    # ⚠ The DENIED cases below are still asserted through `backend_present` on purpose — the gate
    # returns before the device is touched, so they are safe AND they prove the denial actually
    # short-circuits rather than blitting and then reporting a denial.
    assert_eq(bhumi_seat_can(bhumi_backend_seat(be), BHUMI_DEV_OUTPUT, 1000), 1, "foreground backend may present");

    # VT-switch away: the backgrounded backend is denied at the gate.
    bhumi_backend_deactivate(be);
    assert_eq(bhumi_backend_poll(be, &bevs, 1, 1000), BHUMI_SEAT_DENIED, "backgrounded poll -> DENIED");
    assert_eq(bhumi_backend_present(be, 1000), BHUMI_SEAT_DENIED, "backgrounded present -> DENIED");
    bhumi_backend_activate(be);
    assert_eq(bhumi_seat_can(bhumi_backend_seat(be), BHUMI_DEV_OUTPUT, 1000), 1, "reactivated -> may present again");

    # A backend opened with an output-only capability: can present, cannot poll.
    var be2 = bhumi_backend_open(bhumi_cap_new(1, BHUMI_DEV_OUTPUT, 0, 1), 32, 16);
    # Gate predicate, not a live present — same reason as above: this seat is AUTHORIZED, so calling
    # `bhumi_backend_present` here would blit for real on any box with a framebuffer.
    assert_eq(bhumi_seat_can(bhumi_backend_seat(be2), BHUMI_DEV_OUTPUT, 1000), 1, "output-only backend may present");
    assert_eq(bhumi_backend_poll(be2, &bevs, 1, 1000), BHUMI_SEAT_DENIED, "output-only backend poll -> DENIED");

    # Null-capability safety (regression — pre-release review): a null cap (e.g.
    # bhumi_cap_new OOM) must return 0, never dereference address 0.
    assert_eq(bhumi_backend_open(0, 64, 48), 0, "backend_open(null cap) -> 0, no crash");
    assert_eq(bhumi_cap_subject(0), 0, "cap_subject(null) -> 0");

    # ----- seat.cyr — optional provenance verify hook (BHUMI_CAP_SIG) --
    test_group("seat.cyr — bhumi_cap_verify");
    var vcap = bhumi_cap_new(0x11, 0x22, 0x33, 0x44);
    var msgbuf[32];
    assert_eq(bhumi_cap_signed_bytes(vcap, &msgbuf), 32, "signed bytes = 32");
    assert_eq(load64(&msgbuf + 0),  0x11, "msg +0  = subject");
    assert_eq(load64(&msgbuf + 8),  0x22, "msg +8  = devices");
    assert_eq(load64(&msgbuf + 16), 0x33, "msg +16 = expiry");
    assert_eq(load64(&msgbuf + 24), 0x44, "msg +24 = issuer");

    var pk[32];
    store8(&pk, 0xCD);                                  # the trusted issuer key
    # Unsigned cap never verifies.
    assert_eq(bhumi_cap_verify(vcap, &_test_ed_verify, &pk), 0, "unsigned cap -> 0");
    # Attach a good signature -> verifies.
    var goodsig[64];
    store8(&goodsig, 0xAB);
    bhumi_cap_set_sig(vcap, &goodsig);
    assert_neq(bhumi_cap_sig(vcap), 0, "sig attached");
    assert_eq(bhumi_cap_verify(vcap, &_test_ed_verify, &pk), 1, "good sig + trusted key -> verified");
    # Bad signature -> fails.
    var badsig[64];
    store8(&badsig, 0x00);
    bhumi_cap_set_sig(vcap, &badsig);
    assert_eq(bhumi_cap_verify(vcap, &_test_ed_verify, &pk), 0, "bad signature -> not verified");
    # Wrong issuer key -> fails.
    bhumi_cap_set_sig(vcap, &goodsig);
    var badpk[32];
    store8(&badpk, 0x00);
    assert_eq(bhumi_cap_verify(vcap, &_test_ed_verify, &badpk), 0, "wrong issuer key -> not verified");
    # Null verifier / null cap -> 0 (no crash).
    assert_eq(bhumi_cap_verify(vcap, 0, &pk), 0, "null verifier -> 0");
    assert_eq(bhumi_cap_verify(0, &_test_ed_verify, &pk), 0, "null cap -> 0");

    # ----- kbscan.cyr — Set-1 scancode decode (the agnos keyboard path) -----
    test_group("kbscan.cyr — Set-1 scancode decode");
    var sc[8];
    var kev[32];   # up to 4 packed events (8 bytes each)

    # Single make: Tab (0x0F) -> pressed, HID usage 0x2B.
    store8(&sc, 0x0F);
    assert_eq(bhumi_scancode_process(&sc, 1, &kev, 4), 1, "Tab make -> 1 event");
    assert_eq(bhumi_key_pressed(load64(&kev)), 1, "Tab make is a press");
    assert_eq(bhumi_key_usage(load64(&kev)), 0x2B, "Tab -> HID usage 0x2B");

    # Break code: Tab release (0x0F | 0x80 = 0x8F) -> release, same usage.
    store8(&sc, 0x8F);
    assert_eq(bhumi_scancode_process(&sc, 1, &kev, 4), 1, "Tab break -> 1 event");
    assert_eq(bhumi_key_pressed(load64(&kev)), 0, "Tab break is a release");
    assert_eq(bhumi_key_usage(load64(&kev)), 0x2B, "Tab break -> HID usage 0x2B");

    # The keys the compositor acts on: Esc / F4 / F5 / F6.
    store8(&sc, 0x01); bhumi_scancode_process(&sc, 1, &kev, 4);
    assert_eq(bhumi_key_usage(load64(&kev)), 0x29, "Esc -> HID 0x29");
    store8(&sc, 0x3E); bhumi_scancode_process(&sc, 1, &kev, 4);
    assert_eq(bhumi_key_usage(load64(&kev)), 0x3D, "F4 -> HID 0x3D");
    store8(&sc, 0x3F); bhumi_scancode_process(&sc, 1, &kev, 4);
    assert_eq(bhumi_key_usage(load64(&kev)), 0x3E, "F5 -> HID 0x3E");
    store8(&sc, 0x40); bhumi_scancode_process(&sc, 1, &kev, 4);
    assert_eq(bhumi_key_usage(load64(&kev)), 0x3F, "F6 -> HID 0x3F");

    # Letter round-trip: 'a' (Set-1 0x1E) -> HID 0x04.
    store8(&sc, 0x1E); bhumi_scancode_process(&sc, 1, &kev, 4);
    assert_eq(bhumi_key_usage(load64(&kev)), 0x04, "a -> HID 0x04");

    # Extended key: 0xE0 0x48 (Up arrow) -> HID 0x52, one event.
    store8(&sc, 0xE0); store8(&sc + 1, 0x48);
    assert_eq(bhumi_scancode_process(&sc, 2, &kev, 4), 1, "E0 48 (Up) -> 1 event");
    assert_eq(bhumi_key_usage(load64(&kev)), 0x52, "Up arrow -> HID 0x52");

    # Unmapped code emits nothing.
    store8(&sc, 0x00);
    assert_eq(bhumi_scancode_process(&sc, 1, &kev, 4), 0, "unmapped scancode -> 0 events");

    # Two keys in one drain -> two events, in order.
    store8(&sc, 0x0F); store8(&sc + 1, 0x3E);
    assert_eq(bhumi_scancode_process(&sc, 2, &kev, 4), 2, "Tab+F4 -> 2 events");
    assert_eq(bhumi_key_usage(load64(&kev)), 0x2B, "first event is Tab");
    assert_eq(bhumi_key_usage(load64(&kev + 8)), 0x3D, "second event is F4");

    # ================================================================
    # ptrscan.cyr — the pointer seam
    # ================================================================
    # ⛔ THE KIND TAG IS THE SAFETY PROPERTY, so it is asserted first and hardest. A pointer event that
    # reads as a key is not a cosmetic bug: `bhumi_key_usage` is `ev & 0xFF`, and a vertical motion of 41
    # is HID 0x29 = Escape, which aethersafha maps to QUIT. An untagged pointer event would close the
    # desktop on downward mouse movement.
    test_group("ptrscan.cyr — event kind keeps pointer events out of the key path");
    assert_eq(bhumi_ev_kind(bhumi_key_event(1, 0x29)), BhumiEvKind.BHUMI_EV_KEY, "a key event is kind 0");
    assert_eq(bhumi_ev_is_key(bhumi_key_event(1, 0x04)), 1, "is_key accepts a key");
    # ⭐ THE REGRESSION GUARD FOR THE WHOLE SCHEME: kind 0 means every legacy event is bit-for-bit
    # unchanged, so no existing producer or consumer had to be touched. If this ever fails, the tag moved
    # and every key event in the tree changed value.
    assert_eq(bhumi_key_event(1, 0x29), 0x129, "a key event is UNCHANGED by the tagging scheme");
    assert_eq(bhumi_ev_is_key(bhumi_motion_event(3, 4)), 0, "a motion event is NOT a key");
    assert_eq(bhumi_ev_is_key(bhumi_button_event(1, 1)), 0, "a button event is NOT a key");
    # The exact value that would quit the compositor if the tag were missing.
    assert_eq(bhumi_ev_kind(bhumi_motion_event(0, 41)), BhumiEvKind.BHUMI_EV_MOTION,
              "dy=41 is tagged MOTION, not read as HID 0x29 (Escape)");

    test_group("ptrscan.cyr — signed motion survives the pack/unpack round trip");
    assert_eq(bhumi_motion_dx(bhumi_motion_event(7, 9)), 7, "dx positive");
    assert_eq(bhumi_motion_dy(bhumi_motion_event(7, 9)), 9, "dy positive");
    # ⛔ NEGATIVE MOTION IS THE CASE A NAIVE PACK LOSES — left and up are the common directions, and a
    # mask-without-sign-extend turns dx = -1 into +16777215, i.e. the cursor teleports right instead of
    # moving left by one pixel.
    assert_eq(bhumi_motion_dx(bhumi_motion_event(0 - 1, 0)), 0 - 1, "dx = -1 (LEFT) survives");
    assert_eq(bhumi_motion_dy(bhumi_motion_event(0, 0 - 1)), 0 - 1, "dy = -1 (UP) survives");
    assert_eq(bhumi_motion_dx(bhumi_motion_event(0 - 500, 300)), 0 - 500, "large negative dx");
    assert_eq(bhumi_motion_dy(bhumi_motion_event(0 - 500, 300)), 300, "...and dy is independent of it");
    assert_eq(bhumi_motion_dy(bhumi_motion_event(0 - 7, 0 - 9)), 0 - 9, "both negative at once");
    # The 24-bit boundaries, so an off-by-one in the sign test fails.
    assert_eq(bhumi_motion_dx(bhumi_motion_event(8388607, 0)), 8388607, "largest positive s24");
    assert_eq(bhumi_motion_dx(bhumi_motion_event(0 - 8388608, 0)), 0 - 8388608, "most negative s24");

    test_group("ptrscan.cyr — buttons carry level AND the click that happened inside the gap");
    assert_eq(bhumi_button_state(bhumi_button_event(1, 3)), 1, "current level");
    assert_eq(bhumi_button_seen(bhumi_button_event(1, 3)), 3, "OR-accumulated since the drain");
    # ⭐ THE CASE `seen` EXISTS FOR: press and release both land inside one frame, so the level reads 0
    # and a consumer watching only the level never sees the click at all.
    assert_eq(bhumi_button_state(bhumi_button_event(0, 1)), 0, "click completed: level is 0");
    assert_eq(bhumi_button_seen(bhumi_button_event(0, 1)), 1, "...but seen still reports it");

    test_group("ptrscan.cyr — record decode is zero-suppressed");
    # ⛔⛔ THE SAME BYTES-NOT-WORDS TRAP, IN THE TEST THAT GUARDS THE DECODER. `var prec[2]` is 2 BYTES,
    # and `store32(&prec + 12, ...)` writes bytes 12-15 of it; `var ptev[4]` is 4 BYTES while
    # `bhumi_ptr_decode(&prec, &ptev, 4)` is authorised to write 4 events = 32. Roughly 40 bytes of this
    # frame — other locals and the return address — were being overwritten, and the asserts passed anyway,
    # which is the worst version of this bug: a green test standing on a smashed stack.
    var prec[16];                      # 16 BYTES: exactly one kernel ptrscan record
    var ptev[32];                      # 32 BYTES: room for the 4 events decode is allowed to write
    store32(&prec + 0, 5); store32(&prec + 4, 0 - 3 & 0xFFFFFFFF);
    store32(&prec + 8, 0); store32(&prec + 12, 0);
    assert_eq(bhumi_ptr_decode(&prec, &ptev, 4), 1, "motion only -> one event");
    assert_eq(bhumi_motion_dx(load64(&ptev)), 5, "decoded dx");
    assert_eq(bhumi_motion_dy(load64(&ptev)), 0 - 3, "decoded dy is NEGATIVE (up)");
    store32(&prec + 8, 1); store32(&prec + 12, 1);
    assert_eq(bhumi_ptr_decode(&prec, &ptev, 4), 2, "motion + button -> two events");
    assert_eq(bhumi_ev_kind(load64(&ptev + 8)), BhumiEvKind.BHUMI_EV_BUTTON, "second event is the button");
    store32(&prec + 0, 0); store32(&prec + 4, 0);
    store32(&prec + 8, 0); store32(&prec + 12, 0);
    assert_eq(bhumi_ptr_decode(&prec, &ptev, 4), 0, "a wholly idle record emits NOTHING");
    # ⚠ The shared budget: a decode must never write past what the caller allowed.
    store32(&prec + 0, 5); store32(&prec + 8, 1);
    assert_eq(bhumi_ptr_decode(&prec, &ptev, 1), 1, "max_ev=1 caps the write at one event");
    assert_eq(bhumi_ptr_decode(&prec, &ptev, 0), 0, "max_ev=0 writes nothing");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);

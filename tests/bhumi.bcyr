# bhumi benchmarks
# Stdlib auto-included via cyrius.cyml. src/main.cyr source-included so the
# benchmark can call bhumi_fb_* / bhumi_pattern_* by name (see
# docs/architecture/001-cyrius-test-const-visibility.md).
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# For sub-1us ops use batch_size >= 1000 to amortize clock_gettime overhead
# (~240 ns per start/stop pair on x86_64 Linux). See lib/bench.cyr header for
# the full overhead-vs-batching guidance.

include "src/main.cyr"

fn bench_noop(): i64 { return 0; }

fn main(): i64 {
    alloc_init();

    var b = bench_new("noop");
    bench_batch_start(b);
    var i = 0;
    while (i < 1000000) { bench_noop(); i = i + 1; }
    bench_batch_stop(b, 1000000);
    bench_report(b);

    # Draw-path throughput at a realistic scanout size (720p, ~921k px/frame).
    # One "op" is a full-framebuffer paint; batch is small since each op is
    # already millions of pixel writes (well above the clock overhead floor).
    var fb = bhumi_fb_new(1280, 720);

    var bars = bench_new("pattern_bars 1280x720");
    bench_batch_start(bars);
    var j = 0;
    while (j < 30) { bhumi_pattern_bars(fb); j = j + 1; }
    bench_batch_stop(bars, 30);
    bench_report(bars);

    var xg = bench_new("pattern_xor 1280x720");
    bench_batch_start(xg);
    var k = 0;
    while (k < 30) { bhumi_pattern_xor(fb); k = k + 1; }
    bench_batch_stop(xg, 30);
    bench_report(xg);

    return 0;
}

var r = main();
syscall(60, r);

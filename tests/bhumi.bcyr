# bhumi benchmarks
# Stdlib auto-included via cyrius.cyml. src/main.cyr source-included so the
# benchmark can call bhumi_* by name (see
# docs/architecture/001-cyrius-test-const-visibility.md). Run: cyrius bench tests/bhumi.bcyr
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# For sub-1us ops use batch_size >= 1000 to amortize clock_gettime overhead
# (~240 ns per start/stop pair on x86_64 Linux). See lib/bench.cyr header.
# Results captured in docs/benchmarks.md.

include "src/main.cyr"

fn bench_noop(): i64 { return 0; }

fn main(): i64 {
    alloc_init();

    # --- clock-overhead baseline ---
    var b0 = bench_new("noop (clock baseline)");
    bench_batch_start(b0);
    var i0 = 0;
    while (i0 < 1000000) { bench_noop(); i0 = i0 + 1; }
    bench_batch_stop(b0, 1000000);
    bench_report(b0);

    # --- output: 720p full-frame ops (per-frame cost) ---
    var fb = bhumi_fb_new(1280, 720);
    var blue = bhumi_xrgb(0x00, 0x00, 0xFF);

    var bc = bench_new("fb_clear 1280x720 (full-frame fill)");
    bench_batch_start(bc);
    var jc = 0;
    while (jc < 30) { bhumi_fb_clear(fb, blue); jc = jc + 1; }
    bench_batch_stop(bc, 30);
    bench_report(bc);

    var bb = bench_new("pattern_bars 1280x720");
    bench_batch_start(bb);
    var jb = 0;
    while (jb < 30) { bhumi_pattern_bars(fb); jb = jb + 1; }
    bench_batch_stop(bb, 30);
    bench_report(bb);

    var bx = bench_new("pattern_xor 1280x720");
    bench_batch_start(bx);
    var jx = 0;
    while (jx < 30) { bhumi_pattern_xor(fb); jx = jx + 1; }
    bench_batch_stop(bx, 30);
    bench_report(bx);

    # --- output: per-pixel bounds-checked write (batched, sub-1us) ---
    var bs = bench_new("fb_set (bounds-checked pixel write)");
    bench_batch_start(bs);
    var ks = 0;
    while (ks < 1000000) {
        bhumi_fb_set(fb, ks & 1023, (ks >> 10) & 511, blue);   # always in [0,1280)x[0,720)
        ks = ks + 1;
    }
    bench_batch_stop(bs, 1000000);
    bench_report(bs);

    # --- input: HID report diff (per report) ---
    var prev[8];
    var cur[8];
    var evs[64];
    memset(&prev, 0, 8);
    memset(&cur, 0, 8);
    store8(&cur + BHUMI_HID_REPORT_KEY0, BHUMI_HID_A);   # one key down per diff
    var bd = bench_new("kbd_diff (HID report decode)");
    bench_batch_start(bd);
    var kd = 0;
    while (kd < 1000000) { bhumi_kbd_diff(&prev, &cur, &evs, 8); kd = kd + 1; }
    bench_batch_stop(bd, 1000000);
    bench_report(bd);

    # --- seat: the capability gate check ---
    var cap = bhumi_cap_new(1, BHUMI_DEV_OUTPUT | BHUMI_DEV_INPUT, 0, 1);
    var seat = bhumi_seat_new(1);
    bhumi_seat_grant(seat, cap);
    bhumi_seat_activate(seat);
    var bg = bench_new("seat_can (capability gate check)");
    bench_batch_start(bg);
    var kg = 0;
    while (kg < 1000000) { bhumi_seat_can(seat, BHUMI_DEV_OUTPUT, 1000); kg = kg + 1; }
    bench_batch_stop(bg, 1000000);
    bench_report(bg);

    return 0;
}

var r = main();
syscall(60, r);
